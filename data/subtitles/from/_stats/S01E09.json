{"episode": "S01E09", "runtime_min": 42.9, "cues": 640, "words": 3622, "words_per_min": 84.5, "density_per_min": [146, 209, 47, 97, 56, 94, 18, 41, 0, 0, 45, 99, 88, 87, 76, 139, 69, 97, 113, 140, 105, 110, 112, 52, 109, 53, 109, 115, 124, 109, 65, 68, 107, 58, 105, 93, 101, 83, 65, 89, 79, 42, 28], "top_silences": [{"from": 477.4, "to": 618.8, "secs": 141.4}], "speaker_lines": {}, "name_mentions": {"Boyd": 1, "Jim": 4, "Ethan": 3, "Victor": 2, "Sara": 8, "Kenny": 1, "Donna": 10, "Kristi": 2, "Jade": 4, "Fatima": 1, "Abby": 1, "Nathan": 2}, "phrases": [{"phrase": "whoa whoa whoa", "count": 6}, {"phrase": "whoa whoa whoa whoa", "count": 4}, {"phrase": "fish and loaves", "count": 2}, {"phrase": "over the tree", "count": 2}, {"phrase": "find our way", "count": 2}, {"phrase": "plenty of wood", "count": 2}, {"phrase": "walk and walk", "count": 2}, {"phrase": "wait wait wait", "count": 2}, {"phrase": "tower's gonna work", "count": 2}, {"phrase": "let's get wood", "count": 2}, {"phrase": "need this place", "count": 2}, {"phrase": "fuck oh fuck", "count": 2}, {"phrase": "grieving the fact", "count": 2}, {"phrase": "let me help", "count": 2}, {"phrase": "it's gonna work", "count": 2}, {"phrase": "it's okay it's", "count": 2}, {"phrase": "where's the talisman", "count": 2}, {"phrase": "mr fish and loaves", "count": 2}, {"phrase": "over the tree line", "count": 2}, {"phrase": "down to the barn", "count": 2}, {"phrase": "ask you a question", "count": 2}, {"phrase": "figure out the story", "count": 2}, {"phrase": "talk to me talk", "count": 2}], "dialogue": [{"t": 1.03, "speaker": null, "line": "Previously on \"From\"..."}, {"t": 2.35, "speaker": null, "line": "Still can't afford to buy a boat."}, {"t": 3.77, "speaker": null, "line": "You know what they used to call me in the army, right?"}, {"t": 5.73, "speaker": null, "line": "Mr. Fish and Loaves."}, {"t": 5.73, "speaker": null, "line": "That's right! That's right!"}, {"t": 8.53, "speaker": null, "line": "No matter what the resources, I would make it work."}, {"t": 10.76, "speaker": null, "line": "Dad!"}, {"t": 10.76, "speaker": null, "line": "Oh!"}, {"t": 13.31, "speaker": null, "line": "Welcome to your worst nightmare."}, {"t": 15.92, "speaker": null, "line": "It's Mom. I think this place is starting to get to her."}, {"t": 18.49, "speaker": null, "line": "You've been going out there for weeks now,"}, {"t": 19.82, "speaker": null, "line": "and you're not seeing what's happening here."}, {"t": 22.15, "speaker": null, "line": "Help your Mom get everybody secured, tucked away."}, {"t": 23.79, "speaker": null, "line": "And when I get home tonight, we will talk."}, {"t": 26.5, "speaker": null, "line": "I promise."}, {"t": 38.34, "speaker": null, "line": "The only way for us to go home"}, {"t": 40.3, "speaker": null, "line": "is to wake everyone up."}, {"t": 41.25, "speaker": null, "line": "Abby, stop!"}, {"t": 42.74, "speaker": null, "line": "I found something, s-something I think is gonna help us."}, {"t": 45.09, "speaker": null, "line": "Mom!"}, {"t": 46.77, "speaker": null, "line": "No, no!"}, {"t": 48.57, "speaker": null, "line": "They're in the house!"}, {"t": 53.63, "speaker": null, "line": "We have to go."}, {"t": 54.95, "speaker": null, "line": "Go where? Where are we going?"}, {"t": 57.49, "speaker": null, "line": "You go first."}, {"t": 59.17, "speaker": null, "line": "I'll follow you down."}, {"t": 60.82, "speaker": null, "line": "We need to get to town."}, {"t": 63.2, "speaker": null, "line": "No. We have to go to the trees."}, {"t": 65.83, "speaker": null, "line": "You have to get inside."}, {"t": 67.24, "speaker": null, "line": "The tree? No!"}, {"t": 68.62, "speaker": null, "line": "You'll be safe!"}, {"t": 69.62, "speaker": null, "line": "What?"}, {"t": 69.62, "speaker": null, "line": "I promise."}, {"t": 70.87, "speaker": null, "line": "Go, go!"}, {"t": 70.87, "speaker": null, "line": "No, wait!"}, {"t": 72.22, "speaker": null, "line": "Find your brother. I'll be right behind..."}, {"t": 76.03, "speaker": null, "line": "You went through a Farway tree!"}, {"t": 78.74, "speaker": null, "line": "Honey..."}, {"t": 78.74, "speaker": null, "line": "What is going on?"}, {"t": 80.52, "speaker": null, "line": "What's happening?"}, {"t": 81.73, "speaker": null, "line": "We're digging a big hole in the basement."}, {"t": 84.11, "speaker": null, "line": "We're gonna find out where the electricity comes from."}, {"t": 87.1, "speaker": null, "line": "Is anybody out there?"}, {"t": 89.18, "speaker": null, "line": "All I got was some static, but it worked."}, {"t": 92.41, "speaker": null, "line": "I think if we get it up over the tree line,"}, {"t": 94.15, "speaker": null, "line": "and we get it enough power,"}, {"t": 95.28, "speaker": null, "line": "I think we could get a signal out."}, {"t": 96.78, "speaker": null, "line": "How do you propose we get up over the tree line?"}, {"t": 98.91, "speaker": null, "line": "We start by going to the high ground."}, {"t": 100.88, "speaker": null, "line": "If these voices are real,"}, {"t": 102.51, "speaker": null, "line": "if something here is communicating with you,"}, {"t": 104.39, "speaker": null, "line": "then that means you're connected to this place"}, {"t": 106.05, "speaker": null, "line": "in a way that no one else here is."}, {"t": 107.9, "speaker": null, "line": "But we need proof."}, {"t": 109.08, "speaker": null, "line": "What is this?"}, {"t": 110.34, "speaker": null, "line": "They said they watched you bury the bag"}, {"t": 112.61, "speaker": null, "line": "and that this is proof that they're real."}, {"t": 115.55, "speaker": null, "line": "I have Sara tied up in the basement of the church."}, {"t": 118.01, "speaker": null, "line": "Tell me you're joking."}, {"t": 119.07, "speaker": null, "line": "That girl may be the key to unlocking all this."}, {"t": 121.59, "speaker": null, "line": "That girl may be the way we all go home."}, {"t": 124.69, "speaker": null, "line": "Let's take a walk."}, {"t": 127.37, "speaker": null, "line": "Where are we going?"}, {"t": 129.3, "speaker": null, "line": "Find our way home."}, {"t": 151.18, "speaker": null, "line": "How do you know this is the right way to go?"}, {"t": 153.78, "speaker": null, "line": "I don't."}, {"t": 155.08, "speaker": null, "line": "I'm just following my best hunch."}, {"t": 158.88, "speaker": null, "line": "Based on what?"}, {"t": 164.31, "speaker": null, "line": "Based on that."}, {"t": 181.8, "speaker": null, "line": "What is that?"}, {"t": 184.71, "speaker": null, "line": "I don't know."}, {"t": 187.11, "speaker": null, "line": "No idea."}, {"t": 189.03, "speaker": null, "line": "But it's, uh... It's where I found these."}, {"t": 192.26, "speaker": null, "line": "Okay."}, {"t": 194.31, "speaker": null, "line": "We're gonna camp out here for the night."}, {"t": 196.9, "speaker": null, "line": "But it's not dark yet."}, {"t": 198.34, "speaker": null, "line": "Hey, look, this right here is as far as I've ever gotten."}, {"t": 201.63, "speaker": null, "line": "Once we go beyond this point,"}, {"t": 203.3, "speaker": null, "line": "we're in completely uncharted territory,"}, {"t": 205.3, "speaker": null, "line": "and I'm not about to do that two hours before dark."}, {"t": 207.96, "speaker": null, "line": "We camp here. Go inside."}, {"t": 211.1, "speaker": null, "line": "Will you at least take these off?"}, {"t": 212.93, "speaker": null, "line": "No."}, {"t": 215.07, "speaker": null, "line": "I have to go to the bathroom."}, {"t": 217.15, "speaker": null, "line": "Well, that's why I cuffed you in front."}, {"t": 219.1, "speaker": null, "line": "Don't go far."}, {"t": 229.12, "speaker": null, "line": "Speaks Cantonese..."}, {"t": 275.98, "speaker": null, "line": "Hey, you."}, {"t": 277.76, "speaker": null, "line": "Hey."}, {"t": 278.8, "speaker": null, "line": "I, uh, finished Chapter 6."}, {"t": 281.43, "speaker": null, "line": "Ah."}, {"t": 281.43, "speaker": null, "line": "You're up."}, {"t": 283.04, "speaker": null, "line": "What do you think so far?"}, {"t": 284.4, "speaker": null, "line": "Well, it's not exactly my favorite,"}, {"t": 286.0, "speaker": null, "line": "but I'm interested to see how things turn out."}, {"t": 288.35, "speaker": null, "line": "You think there's gonna be a happy ending?"}, {"t": 290.64, "speaker": null, "line": "I don't know. I guess we'll find out."}, {"t": 294.16, "speaker": null, "line": "Get home safe, Sheriff."}, {"t": 295.52, "speaker": null, "line": "You, too."}, {"t": 304.09, "speaker": null, "line": "Great work today, everybody."}, {"t": 307.13, "speaker": null, "line": "Come on in."}, {"t": 309.6, "speaker": null, "line": "Hey, you okay?"}, {"t": 312.46, "speaker": null, "line": "Looking a little long in the face."}, {"t": 314.13, "speaker": null, "line": "Oh, uh, that's genetic."}, {"t": 317.04, "speaker": null, "line": "Get a good sleep tonight. The real work starts tomorrow."}, {"t": 319.84, "speaker": null, "line": "Yes, ma'am."}, {"t": 324.14, "speaker": null, "line": "So, livin' in a jail cell now, that's quaint."}, {"t": 328.51, "speaker": null, "line": "It's temporary."}, {"t": 330.39, "speaker": null, "line": "Right. Until we get this miraculous tower set up"}, {"t": 334.08, "speaker": null, "line": "and send our radio signal out to Never land."}, {"t": 336.56, "speaker": null, "line": "Hey. Cut the shit, all right?"}, {"t": 339.56, "speaker": null, "line": "Some of the folks in there need something to feel good about."}, {"t": 342.26, "speaker": null, "line": "Great. Let's play make-believe. I'm game."}, {"t": 356.84, "speaker": null, "line": "Tabby, are you hungry? I made some dinner."}, {"t": 360.12, "speaker": null, "line": "I'll be right up."}, {"t": 399.28, "speaker": null, "line": "Ethan, I told you to pick up the toys!"}, {"t": 415.35, "speaker": null, "line": "Can somebody grab that, please?"}, {"t": 422.73, "speaker": null, "line": "Jim?"}, {"t": 429.3, "speaker": null, "line": "Grab the kids. There's something's wrong."}, {"t": 433.74, "speaker": null, "line": "Jim, answer me!"}, {"t": 436.75, "speaker": null, "line": "Jim?"}, {"t": 446.69, "speaker": null, "line": "Oh, my God."}, {"t": 449.84, "speaker": null, "line": "Car horn blaring..."}, {"t": 467.99, "speaker": null, "line": "\"Que Sera, Sera Whatever Will Be, Will be\" plays..."}, {"t": 473.12, "speaker": null, "line": "*FROM* Season 01 Episode 09"}, {"t": 475.56, "speaker": null, "line": "Episode Title: \"Into the Woods\" Aired on: April 03 2022."}, {"t": 618.81, "speaker": null, "line": "He kept saying he was fine."}, {"t": 622.6, "speaker": null, "line": "He was making jokes about the tower."}, {"t": 625.73, "speaker": null, "line": "He..."}, {"t": 648.73, "speaker": null, "line": "Oh, that's backwards."}, {"t": 648.73, "speaker": null, "line": "Flip it."}, {"t": 650.94, "speaker": null, "line": "Yeah. Just make sure it's flush."}, {"t": 653.52, "speaker": null, "line": "That's it."}, {"t": 655.23, "speaker": null, "line": "Hey, Kenny."}, {"t": 657.0, "speaker": null, "line": "Hey. Jade's all set up in the kitchen, uh,"}, {"t": 659.68, "speaker": null, "line": "with the batteries, and, uh,"}, {"t": 660.89, "speaker": null, "line": "I think we've got enough wire and cords now for the cable."}, {"t": 662.97, "speaker": null, "line": "All right, well, we're gonna need more material"}, {"t": 665.42, "speaker": null, "line": "if we wanna get this tower up high enough."}, {"t": 667.39, "speaker": null, "line": "Right. I'll send people down to the barn."}, {"t": 670.41, "speaker": null, "line": "I think there should be plenty of wood there"}, {"t": 671.93, "speaker": null, "line": "for them to scavenge."}, {"t": 673.94, "speaker": null, "line": "All right."}, {"t": 673.94, "speaker": null, "line": "Cool."}, {"t": 675.23, "speaker": null, "line": "Hey, how you doing?"}, {"t": 677.27, "speaker": null, "line": "Had a rough morning."}, {"t": 680.62, "speaker": null, "line": "Is, uh... Is Eric with you?"}, {"t": 682.85, "speaker": null, "line": "I need him to go on a supply run."}, {"t": 688.74, "speaker": null, "line": "Eric's not coming."}, {"t": 695.76, "speaker": null, "line": "Hey."}, {"t": 700.82, "speaker": null, "line": "Mind if I join you?"}, {"t": 703.21, "speaker": null, "line": "I would not mind at all."}, {"t": 709.58, "speaker": null, "line": "Hey."}, {"t": 716.63, "speaker": null, "line": "You hear about Eric?"}, {"t": 718.03, "speaker": null, "line": "Yeah."}, {"t": 720.91, "speaker": null, "line": "Yeah."}, {"t": 723.24, "speaker": null, "line": "I-I didn't see that one coming."}, {"t": 729.61, "speaker": null, "line": "It's weird, you know, this radio might actually work,"}, {"t": 734.87, "speaker": null, "line": "and as amazing as that is..."}, {"t": 738.63, "speaker": null, "line": "I think part of me..."}, {"t": 745.32, "speaker": null, "line": "I think the idea that it might work"}, {"t": 748.02, "speaker": null, "line": "is scarier than the idea that it won't."}, {"t": 751.41, "speaker": null, "line": "What do you mean?"}, {"t": 754.03, "speaker": null, "line": "I keep thinking..."}, {"t": 759.38, "speaker": null, "line": "\"How do we go back now?\""}, {"t": 764.68, "speaker": null, "line": "After everything we've seen, some of the things we've done,"}, {"t": 767.48, "speaker": null, "line": "how do we just..."}, {"t": 771.28, "speaker": null, "line": "And even if we can go back, how do..."}, {"t": 776.11, "speaker": null, "line": "I'm not sure we can ever really go home."}, {"t": 780.5, "speaker": null, "line": "We're not the same people anymore."}, {"t": 790.0, "speaker": null, "line": "You know, when my dad..."}, {"t": 791.96, "speaker": null, "line": "came back home from Afghanistan,"}, {"t": 796.14, "speaker": null, "line": "he said that that coming home from war is like..."}, {"t": 800.76, "speaker": null, "line": "it's like traveling from another planet."}, {"t": 804.08, "speaker": null, "line": "And then when you come back,"}, {"t": 805.68, "speaker": null, "line": "you can't tell if everything is different"}, {"t": 809.57, "speaker": null, "line": "than it was when you left it or... or..."}, {"t": 813.59, "speaker": null, "line": "...or if it's you,"}, {"t": 817.06, "speaker": null, "line": "if you're the one that's changed."}, {"t": 820.86, "speaker": null, "line": "What's it gonna be like for us?"}, {"t": 826.07, "speaker": null, "line": "This is the only place we've ever known together."}, {"t": 836.23, "speaker": null, "line": "I'll be right back."}, {"t": 838.98, "speaker": null, "line": "Where you going?"}, {"t": 842.51, "speaker": null, "line": "Go find a sharper knife."}, {"t": 844.42, "speaker": null, "line": "This one's just taking forever."}, {"t": 852.55, "speaker": null, "line": "Hey. Hold up a sec."}, {"t": 858.84, "speaker": null, "line": "What are you doing?"}, {"t": 862.7, "speaker": null, "line": "Making sure we find our way back."}, {"t": 867.07, "speaker": null, "line": "All right, let's go."}, {"t": 881.92, "speaker": null, "line": "How do you know it's not just like the road?"}, {"t": 884.93, "speaker": null, "line": "What's that?"}, {"t": 886.88, "speaker": null, "line": "It just goes in one big loop"}, {"t": 888.8, "speaker": null, "line": "and then brings you back to town."}, {"t": 892.9, "speaker": null, "line": "How do you know this isn't the same?"}, {"t": 896.3, "speaker": null, "line": "How do you know we won't just walk and..."}, {"t": 899.11, "speaker": null, "line": "walk and walk,"}, {"t": 900.79, "speaker": null, "line": "and then end up right back in town where we started?"}, {"t": 904.73, "speaker": null, "line": "I don't."}, {"t": 907.03, "speaker": null, "line": "Guess we'll see."}, {"t": 911.56, "speaker": null, "line": "Let me ask you a question."}, {"t": 914.12, "speaker": null, "line": "You say those voices told you"}, {"t": 915.83, "speaker": null, "line": "that killing those people would get everyone home."}, {"t": 919.7, "speaker": null, "line": "You ever stop to think that maybe they were lying?"}, {"t": 921.87, "speaker": null, "line": "I don't want to talk about that."}, {"t": 921.87, "speaker": null, "line": "Wait, wait, wait."}, {"t": 926.48, "speaker": null, "line": "I think, if we're gonna start second-guessing"}, {"t": 928.84, "speaker": null, "line": "each other's decisions, then that seems like"}, {"t": 931.88, "speaker": null, "line": "a fair question to ask."}, {"t": 933.62, "speaker": null, "line": "So, what is it? What exactly"}, {"t": 936.23, "speaker": null, "line": "did they tell you that made you willing to kill that little boy?"}, {"t": 940.51, "speaker": null, "line": "You wouldn't understand."}, {"t": 942.09, "speaker": null, "line": "Try me."}, {"t": 944.35, "speaker": null, "line": "They told me..."}, {"t": 947.35, "speaker": null, "line": "that those people were coming."}, {"t": 949.86, "speaker": null, "line": "They told me that there would be two cars!"}, {"t": 952.52, "speaker": null, "line": "And they said that if I didn't do what they said..."}, {"t": 957.07, "speaker": null, "line": "Then what?"}, {"t": 958.67, "speaker": null, "line": "If you didn't do what they said, then what?"}, {"t": 960.58, "speaker": null, "line": "Hey, let me explain to you again how this works."}, {"t": 965.21, "speaker": null, "line": "I say jump, you jump."}, {"t": 967.44, "speaker": null, "line": "I ask you a question, then you goddamn answer..."}, {"t": 970.08, "speaker": null, "line": "They said my brother would die, okay?!"}, {"t": 974.51, "speaker": null, "line": "They said that if I didn't do it,"}, {"t": 978.21, "speaker": null, "line": "that he would die, that everyone would die!"}, {"t": 990.8, "speaker": null, "line": "Why didn't you just put me in the box?"}, {"t": 993.3, "speaker": null, "line": "I don't know! I thought..."}, {"t": 1000.14, "speaker": null, "line": "Hey."}, {"t": 1013.39, "speaker": null, "line": "I've seen this town make good people..."}, {"t": 1021.49, "speaker": null, "line": "do bad things."}, {"t": 1028.47, "speaker": null, "line": "Let's keep moving."}, {"t": 1046.02, "speaker": null, "line": "I don't understand."}, {"t": 1047.89, "speaker": null, "line": "Ethan said he thinks it's a puzzle."}, {"t": 1049.95, "speaker": null, "line": "No, not a puzzle."}, {"t": 1051.58, "speaker": null, "line": "A story."}, {"t": 1053.09, "speaker": null, "line": "They all fit together and tell a story."}, {"t": 1055.61, "speaker": null, "line": "And once we figure out the story,"}, {"t": 1057.67, "speaker": null, "line": "we'll know what to do next."}, {"t": 1059.59, "speaker": null, "line": "That's how it works."}, {"t": 1062.46, "speaker": null, "line": "Yeah, um, I think we should stop seeing these."}, {"t": 1065.4, "speaker": null, "line": "But we have to."}, {"t": 1067.04, "speaker": null, "line": "We can't finish the quest unless we figure out the story."}, {"t": 1070.66, "speaker": null, "line": "I'm not scared, I promise."}, {"t": 1073.19, "speaker": null, "line": "I know."}, {"t": 1076.48, "speaker": null, "line": "Do you think Dad's tower's gonna work?"}, {"t": 1078.62, "speaker": null, "line": "I don't know. I mean, we'll just have to wait and see."}, {"t": 1083.04, "speaker": null, "line": "Where do you think this one goes?"}, {"t": 1085.18, "speaker": null, "line": "Oh, yeah, this is super healthy."}, {"t": 1087.49, "speaker": null, "line": "Oh, no, no, no, no, no. Okay."}, {"t": 1088.86, "speaker": null, "line": "Okay. We should... We should stop."}, {"t": 1092.2, "speaker": null, "line": "Um, maybe we should play another game."}, {"t": 1094.53, "speaker": null, "line": "What kind of game?"}, {"t": 1097.91, "speaker": null, "line": "Um..."}, {"t": 1099.14, "speaker": null, "line": "Okay."}, {"t": 1101.47, "speaker": null, "line": "A game called \"When I get home, I...\""}, {"t": 1104.58, "speaker": null, "line": "And we just say whatever we're looking forward to"}, {"t": 1106.72, "speaker": null, "line": "the most about getting home."}, {"t": 1108.58, "speaker": null, "line": "I'll start."}, {"t": 1110.48, "speaker": null, "line": "When I get home, I..."}, {"t": 1114.06, "speaker": null, "line": "I will go to Giovelli's"}, {"t": 1118.0, "speaker": null, "line": "and I will order..."}, {"t": 1120.74, "speaker": null, "line": "everything on that menu."}, {"t": 1122.6, "speaker": null, "line": "Maybe two of everything on the menu."}, {"t": 1125.04, "speaker": null, "line": "Your turn, Jules."}, {"t": 1126.7, "speaker": null, "line": "This is stupid."}, {"t": 1129.07, "speaker": null, "line": "Oh, come on, Jules."}, {"t": 1130.34, "speaker": null, "line": "Fine."}, {"t": 1131.78, "speaker": null, "line": "When I get home, I'm going to, um..."}, {"t": 1138.12, "speaker": null, "line": "I'm gonna call my friends and..."}, {"t": 1142.25, "speaker": null, "line": "I'm just gonna call them."}, {"t": 1146.76, "speaker": null, "line": "What about you?"}, {"t": 1149.93, "speaker": null, "line": "When I get home, I..."}, {"t": 1153.13, "speaker": null, "line": "I want us to be happy, like we are here."}, {"t": 1155.97, "speaker": null, "line": "We never play games around the table at home."}, {"t": 1166.61, "speaker": null, "line": "Okay, look,"}, {"t": 1168.48, "speaker": null, "line": "most of these batteries are way past their expiration date."}, {"t": 1172.55, "speaker": null, "line": "All right, we've got the newer batteries from my car"}, {"t": 1174.89, "speaker": null, "line": "and that giant lunchbox that you guys were driving, but..."}, {"t": 1180.16, "speaker": null, "line": "even those'd drain in a couple of hours."}, {"t": 1182.09, "speaker": null, "line": "We need something that'll keep this running for days"}, {"t": 1185.0, "speaker": null, "line": "or weeks, right? Not hours."}, {"t": 1188.3, "speaker": null, "line": "What we do is we-we take the batteries,"}, {"t": 1190.1, "speaker": null, "line": "we put 'em in the cars and then we just run the cars"}, {"t": 1191.91, "speaker": null, "line": "to recharge them."}, {"t": 1193.17, "speaker": null, "line": "And then what? Burn how much fuel?"}, {"t": 1194.63, "speaker": null, "line": "Look, the point is, you're either burning out"}, {"t": 1196.64, "speaker": null, "line": "one vital resource or another,"}, {"t": 1198.28, "speaker": null, "line": "which would be fine if this was guaranteed to work,"}, {"t": 1200.61, "speaker": null, "line": "but let's be honest, man, it probably won't!"}, {"t": 1202.48, "speaker": null, "line": "Hey. Keep it down."}, {"t": 1212.86, "speaker": null, "line": "Has anyone seen Victor?"}, {"t": 1216.0, "speaker": null, "line": "Look, if you would just take a look at the symbol."}, {"t": 1218.49, "speaker": null, "line": "Open the book!"}, {"t": 1220.53, "speaker": null, "line": "What is wrong with you?"}, {"t": 1223.17, "speaker": null, "line": "We have a legitimate chance here to go home and you're..."}, {"t": 1231.7, "speaker": null, "line": "You know what? Just go."}, {"t": 1233.71, "speaker": null, "line": "Go. Go, go find Victor."}, {"t": 1236.38, "speaker": null, "line": "Do whatever you want."}, {"t": 1238.38, "speaker": null, "line": "I'll stay here, and I'll figure this out myself."}, {"t": 1241.62, "speaker": null, "line": "There's nothing to figure out. There's no power source."}, {"t": 1245.86, "speaker": null, "line": "Jim, this isn't Gilligan's Island."}, {"t": 1247.56, "speaker": null, "line": "You're not gonna build a radio with palm leaves and coconuts."}, {"t": 1250.23, "speaker": null, "line": "Maybe you're not as smart as you think you are."}, {"t": 1257.33, "speaker": null, "line": "Whatever."}, {"t": 1272.32, "speaker": null, "line": "What do you want?"}, {"t": 1276.55, "speaker": null, "line": "I, uh... I heard what happened."}, {"t": 1279.03, "speaker": null, "line": "You okay?"}, {"t": 1281.16, "speaker": null, "line": "Not my bathroom the asshole hung himself in."}, {"t": 1286.36, "speaker": null, "line": "Shouldn't you be out there"}, {"t": 1288.23, "speaker": null, "line": "rounding up supplies or building a spaceship"}, {"t": 1290.66, "speaker": null, "line": "or some shit?"}, {"t": 1292.11, "speaker": null, "line": "I'm just saying, if..."}, {"t": 1293.44, "speaker": null, "line": "if you want someone to talk to..."}, {"t": 1296.14, "speaker": null, "line": "Oh, so, now you're sheriff,"}, {"t": 1298.24, "speaker": null, "line": "you're gonna start doling out words of wisdom?"}, {"t": 1300.28, "speaker": null, "line": "One thing I always appreciated about Boyd"}, {"t": 1303.21, "speaker": null, "line": "is he minded his own business."}, {"t": 1307.92, "speaker": null, "line": "Well, I'm gonna take a few people down to the barn,"}, {"t": 1310.62, "speaker": null, "line": "salvage some more wood for the tower."}, {"t": 1312.62, "speaker": null, "line": "Maybe if you want to..."}, {"t": 1313.93, "speaker": null, "line": "come with us or... I don't know."}, {"t": 1316.43, "speaker": null, "line": "You want wood?"}, {"t": 1319.03, "speaker": null, "line": "We got plenty of wood."}, {"t": 1321.73, "speaker": null, "line": "Where are you going?"}, {"t": 1323.57, "speaker": null, "line": "Let's get wood!"}, {"t": 1326.72, "speaker": null, "line": "Donna!"}, {"t": 1328.2, "speaker": null, "line": "Come on!"}, {"t": 1329.82, "speaker": null, "line": "I'm saving you a trip!"}, {"t": 1331.69, "speaker": null, "line": "Donna!"}, {"t": 1337.25, "speaker": null, "line": "Donna! Hey!"}, {"t": 1341.58, "speaker": null, "line": "Hey!"}, {"t": 1343.42, "speaker": null, "line": "Donna!"}, {"t": 1344.54, "speaker": null, "line": "Donna! Hey!"}, {"t": 1346.16, "speaker": null, "line": "Whoa, whoa, whoa, whoa, whoa!"}, {"t": 1348.59, "speaker": null, "line": "Hey!"}, {"t": 1348.59, "speaker": null, "line": "Donna, wait, wait, wait!"}, {"t": 1350.1, "speaker": null, "line": "Oh, calm the fuck down! I'm not a fuckin' psycho."}, {"t": 1351.53, "speaker": null, "line": "You said we needed wood? Let's get wood."}, {"t": 1354.17, "speaker": null, "line": "Wha...? Okay."}, {"t": 1358.31, "speaker": null, "line": "Donna, please."}, {"t": 1359.92, "speaker": null, "line": "Better here than any of that half-rotten shit"}, {"t": 1363.0, "speaker": null, "line": "you're gonna pull off the barn."}, {"t": 1366.34, "speaker": null, "line": "You gonna get her to stop or you want me to?"}, {"t": 1368.54, "speaker": null, "line": "Donna, stop! We need... We need this place intact."}, {"t": 1371.26, "speaker": null, "line": "For what? Huh?"}, {"t": 1373.54, "speaker": null, "line": "We're all going home, right?"}, {"t": 1375.51, "speaker": null, "line": "We don't need this place anymore."}, {"t": 1378.03, "speaker": null, "line": "Your glorious tower's gonna get us all home."}, {"t": 1381.19, "speaker": null, "line": "No need to keep this place standing."}, {"t": 1384.29, "speaker": null, "line": "It's not a home anymore. It's a fucking tomb!"}, {"t": 1389.83, "speaker": null, "line": "The fuck!"}, {"t": 1391.61, "speaker": null, "line": "Fuck!"}, {"t": 1401.64, "speaker": null, "line": "Look, can we please..."}, {"t": 1403.25, "speaker": null, "line": "Can we please just take a minute and let's..."}, {"t": 1405.32, "speaker": null, "line": "Fuck off!"}, {"t": 1412.3, "speaker": null, "line": "Aw, fuck!"}, {"t": 1415.23, "speaker": null, "line": "Oh, fuck. Oh, fuck."}, {"t": 1439.18, "speaker": null, "line": "It was nice that Ellis came to see you before you left."}, {"t": 1442.85, "speaker": null, "line": "I'm sure he appreciates what you're doing."}, {"t": 1448.25, "speaker": null, "line": "I heard the story about what happened with your wife,"}, {"t": 1451.72, "speaker": null, "line": "what you had to do."}, {"t": 1452.92, "speaker": null, "line": "We're not gonna talk about that."}, {"t": 1455.28, "speaker": null, "line": "That's okay."}, {"t": 1457.38, "speaker": null, "line": "We don't have to. It's..."}, {"t": 1460.34, "speaker": null, "line": "It's just, in some ways..."}, {"t": 1464.25, "speaker": null, "line": "you remind me of Nathan."}, {"t": 1468.02, "speaker": null, "line": "I mean, you're a lot more gruff than he was."}, {"t": 1470.95, "speaker": null, "line": "But... you always put other people's needs before your own."}, {"t": 1475.08, "speaker": null, "line": "That's how he ended up here."}, {"t": 1477.59, "speaker": null, "line": "I don't think he'd like what we're doing now."}, {"t": 1480.26, "speaker": null, "line": "And why is that?"}, {"t": 1481.72, "speaker": null, "line": "Nathan had a theory about this place."}, {"t": 1484.8, "speaker": null, "line": "If we tried to leave, if we pushed too hard,"}, {"t": 1489.27, "speaker": null, "line": "then something would push back."}, {"t": 1497.89, "speaker": null, "line": "What is that?"}, {"t": 1502.92, "speaker": null, "line": "I don't know."}, {"t": 1515.26, "speaker": null, "line": "Are you sure it was coming from this direction?"}, {"t": 1522.24, "speaker": null, "line": "Let's go."}, {"t": 1535.42, "speaker": null, "line": "I thought you said no one had been out this far before."}, {"t": 1541.32, "speaker": null, "line": "No."}, {"t": 1547.94, "speaker": null, "line": "What are you doing?"}, {"t": 1549.31, "speaker": null, "line": "Look, there's something inside them."}, {"t": 1553.18, "speaker": null, "line": "We gotta get one down."}, {"t": 1555.09, "speaker": null, "line": "Just, uh..."}, {"t": 1557.7, "speaker": null, "line": "Are you sure that's a good idea?"}, {"t": 1559.64, "speaker": null, "line": "Maybe we should..."}, {"t": 1562.77, "speaker": null, "line": "Hey, what's wrong?"}, {"t": 1563.88, "speaker": null, "line": "Ow!"}, {"t": 1565.18, "speaker": null, "line": "Ow!"}, {"t": 1566.51, "speaker": null, "line": "Whoa, Sara."}, {"t": 1567.37, "speaker": null, "line": "Ow!"}, {"t": 1569.12, "speaker": null, "line": "Hey, hey, hey. Hey, you're okay."}, {"t": 1572.15, "speaker": null, "line": "You're okay."}, {"t": 1572.15, "speaker": null, "line": "Ow!"}, {"t": 1573.53, "speaker": null, "line": "Look at me, Sara. You're okay."}, {"t": 1574.77, "speaker": null, "line": "No! No!"}, {"t": 1576.4, "speaker": null, "line": "Look... What's going on?"}, {"t": 1577.75, "speaker": null, "line": "Sara! Sara!"}, {"t": 1581.34, "speaker": null, "line": "I can hear them! I can..."}, {"t": 1583.15, "speaker": null, "line": "No, no. Talk to me."}, {"t": 1584.53, "speaker": null, "line": "Talk to me. Talk to me."}, {"t": 1586.06, "speaker": null, "line": "No, no, no, no!"}, {"t": 1587.53, "speaker": null, "line": "No! No!"}, {"t": 1588.8, "speaker": null, "line": "No, no, no, no, no, no, no! Don't, don't! No, no!"}, {"t": 1591.4, "speaker": null, "line": "No. Sara? No, no, no. Okay."}, {"t": 1594.72, "speaker": null, "line": "No, Sara! Sara! Hey!"}, {"t": 1601.51, "speaker": null, "line": "How's the magic tower coming?"}, {"t": 1609.71, "speaker": null, "line": "You know, all the time I've been here,"}, {"t": 1611.42, "speaker": null, "line": "this is first you've set foot in this place."}, {"t": 1616.83, "speaker": null, "line": "Because you serve piss water. Your distilling is for shit."}, {"t": 1620.75, "speaker": null, "line": "At least here, I can be alone."}, {"t": 1625.14, "speaker": null, "line": "Oh."}, {"t": 1626.6, "speaker": null, "line": "Kinda feels like a banner day today."}, {"t": 1628.76, "speaker": null, "line": "Feel like I'm holding court."}, {"t": 1631.09, "speaker": null, "line": "You mind giving us a second?"}, {"t": 1633.76, "speaker": null, "line": "Yeah."}, {"t": 1636.26, "speaker": null, "line": "I'll leave this here."}, {"t": 1638.41, "speaker": null, "line": "Give me a holler if you need anything, okay?"}, {"t": 1646.36, "speaker": null, "line": "Are you okay?"}, {"t": 1651.31, "speaker": null, "line": "Donna, I know you're upset about Eric,"}, {"t": 1653.21, "speaker": null, "line": "but there's nothing you could have..."}, {"t": 1654.65, "speaker": null, "line": "Oh, for fuck's sake, it's not about that."}, {"t": 1659.77, "speaker": null, "line": "Eric punched his own ticket."}, {"t": 1663.59, "speaker": null, "line": "Kid's got a right to go out the way he wants."}, {"t": 1667.27, "speaker": null, "line": "Why don't you just fuck off and leave me be."}, {"t": 1669.89, "speaker": null, "line": "Go back to your little fantasy land."}, {"t": 1673.8, "speaker": null, "line": "You don't think the tower's gonna work."}, {"t": 1677.89, "speaker": null, "line": "Do you?"}, {"t": 1679.58, "speaker": null, "line": "I think it might. I think it's worth trying."}, {"t": 1684.28, "speaker": null, "line": "And what happens when you fail?"}, {"t": 1688.24, "speaker": null, "line": "Then we try again."}, {"t": 1689.78, "speaker": null, "line": "No!"}, {"t": 1690.92, "speaker": null, "line": "No, ya stupid little shit."}, {"t": 1693.62, "speaker": null, "line": "That's the point. You don't try again,"}, {"t": 1696.5, "speaker": null, "line": "because you got people's hopes up,"}, {"t": 1698.64, "speaker": null, "line": "you made them believe."}, {"t": 1700.18, "speaker": null, "line": "You take that away now and they're lost,"}, {"t": 1702.81, "speaker": null, "line": "they give up, and then they fucking die."}, {"t": 1707.93, "speaker": null, "line": "'Cause it isn't some grade-school softball game"}, {"t": 1711.98, "speaker": null, "line": "where everyone gets a participation medal."}, {"t": 1714.74, "speaker": null, "line": "You don't know!"}, {"t": 1716.85, "speaker": null, "line": "You don't remember what it was like before"}, {"t": 1719.2, "speaker": null, "line": "because you weren't here."}, {"t": 1724.13, "speaker": null, "line": "You wanna know what I'm grieving?"}, {"t": 1726.88, "speaker": null, "line": "I'm grieving the loss of what we almost made this place."}, {"t": 1732.05, "speaker": null, "line": "I'm grieving the fact that, for a little while,"}, {"t": 1735.27, "speaker": null, "line": "this place almost felt like something that could work."}, {"t": 1737.82, "speaker": null, "line": "I am grieving the fact that you guys are so caught up"}, {"t": 1741.68, "speaker": null, "line": "in playing Mr. Fucking Wizard that you can't see"}, {"t": 1744.48, "speaker": null, "line": "what this place is gonna become when you fail."}, {"t": 1756.94, "speaker": null, "line": "So, what are we supposed to do?"}, {"t": 1761.51, "speaker": null, "line": "What are we supposed to do?"}, {"t": 1762.81, "speaker": null, "line": "Just sit here and not try to go home?"}, {"t": 1766.27, "speaker": null, "line": "Live in a place where those things come to hunt us"}, {"t": 1768.28, "speaker": null, "line": "every single night?"}, {"t": 1769.46, "speaker": null, "line": "Oh, God, the fuck..."}, {"t": 1772.11, "speaker": null, "line": "Why not?"}, {"t": 1773.79, "speaker": null, "line": "At least here, the monsters have the decency"}, {"t": 1776.52, "speaker": null, "line": "to show you what they are."}, {"t": 1783.63, "speaker": null, "line": "I know you guys from town look at Colony House"}, {"t": 1789.01, "speaker": null, "line": "and figure it's all just drinking and fucking."}, {"t": 1792.92, "speaker": null, "line": "But it was more than that."}, {"t": 1796.58, "speaker": null, "line": "It was special."}, {"t": 1799.33, "speaker": null, "line": "All those people from all those different places,"}, {"t": 1803.78, "speaker": null, "line": "different lives, everyone living together."}, {"t": 1806.66, "speaker": null, "line": "For all the fear"}, {"t": 1808.92, "speaker": null, "line": "and all the monsters-in-the-forest bullshit,"}, {"t": 1812.35, "speaker": null, "line": "there was something,"}, {"t": 1813.95, "speaker": null, "line": "there was a joy in that house."}, {"t": 1820.31, "speaker": null, "line": "For a little while, anyways."}, {"t": 1822.96, "speaker": null, "line": "And, like most things, none of us appreciated it"}, {"t": 1826.96, "speaker": null, "line": "nearly as much as we should have, and now it's fucking gone."}, {"t": 1838.59, "speaker": null, "line": "I'm sorry."}, {"t": 1841.45, "speaker": null, "line": "Yeah."}, {"t": 1844.57, "speaker": null, "line": "Me, too."}, {"t": 1855.23, "speaker": null, "line": "Look, I'm gonna put my game face"}, {"t": 1859.26, "speaker": null, "line": "back on tomorrow,"}, {"t": 1861.37, "speaker": null, "line": "and we'll give that tower a shot."}, {"t": 1868.21, "speaker": null, "line": "But you have to be prepared for the fallout if it doesn't work."}, {"t": 1872.7, "speaker": null, "line": "And if it does work..."}, {"t": 1877.23, "speaker": null, "line": "I think you'll find there's more you're gonna miss"}, {"t": 1880.86, "speaker": null, "line": "about this place than you thought."}, {"t": 1900.86, "speaker": null, "line": "That kinda day, huh?"}, {"t": 1906.37, "speaker": null, "line": "Just ironing out a few wrinkles, that's all."}, {"t": 1909.36, "speaker": null, "line": "Yeah."}, {"t": 1910.97, "speaker": null, "line": "Where's Jade?"}, {"t": 1913.25, "speaker": null, "line": "He's, uh... I don't know."}, {"t": 1917.93, "speaker": null, "line": "Okay?"}, {"t": 1919.33, "speaker": null, "line": "Donna did a number on the floor."}, {"t": 1921.49, "speaker": null, "line": "Yeah."}, {"t": 1923.17, "speaker": null, "line": "She knows how to wield an axe, I'll give her that."}, {"t": 1934.02, "speaker": null, "line": "Well, better get back to it."}, {"t": 1937.34, "speaker": null, "line": "So, we got that coil for the CB that you needed,"}, {"t": 1940.85, "speaker": null, "line": "and we should have enough wire stripped for the cord."}, {"t": 1944.03, "speaker": null, "line": "That's great."}, {"t": 1945.74, "speaker": null, "line": "Is it?"}, {"t": 1947.02, "speaker": null, "line": "Well, yeah. I mean, look,"}, {"t": 1949.19, "speaker": null, "line": "I'm not gonna stand here and pretend that it was a great day."}, {"t": 1952.53, "speaker": null, "line": "These are setbacks, nothing more."}, {"t": 1955.7, "speaker": null, "line": "Look, you got what we need for the radio,"}, {"t": 1958.13, "speaker": null, "line": "tower's almost finished, and I'm gonna figure this out."}, {"t": 1962.34, "speaker": null, "line": "How?"}, {"t": 1963.86, "speaker": null, "line": "Well, that I don't know."}, {"t": 1965.81, "speaker": null, "line": "But one thing you learn as an engineer: There's always a way."}, {"t": 1970.75, "speaker": null, "line": "We will figure this out."}, {"t": 2003.17, "speaker": null, "line": "Hey."}, {"t": 2007.65, "speaker": null, "line": "Hey."}, {"t": 2009.32, "speaker": null, "line": "Are you okay?"}, {"t": 2014.99, "speaker": null, "line": "Eric was a friend."}, {"t": 2018.65, "speaker": null, "line": "Oh God, I'm... I'm sorry."}, {"t": 2021.56, "speaker": null, "line": "I-I didn't know that you guys were close."}, {"t": 2026.07, "speaker": null, "line": "He had celiac disease,"}, {"t": 2029.14, "speaker": null, "line": "so he came to the clinic a lot."}, {"t": 2031.46, "speaker": null, "line": "He was always bloated and dehydrated."}, {"t": 2035.28, "speaker": null, "line": "I kept telling him to stop eating bread."}, {"t": 2038.14, "speaker": null, "line": "But he always said things like, \"I'm already in shitsville,"}, {"t": 2041.74, "speaker": null, "line": "\"now you want me to give up carbs?\""}, {"t": 2044.92, "speaker": null, "line": "He just had this way about him, you know?"}, {"t": 2047.37, "speaker": null, "line": "He was one of the people that, when I first got here, he..."}, {"t": 2053.33, "speaker": null, "line": "just made it a lot easier."}, {"t": 2057.59, "speaker": null, "line": "And now he's gone, so..."}, {"t": 2069.65, "speaker": null, "line": "Hey, Kristi..."}, {"t": 2071.45, "speaker": null, "line": "Look, I know you've had a hard time lately,"}, {"t": 2075.95, "speaker": null, "line": "and that this tower means a lot to everybody,"}, {"t": 2079.29, "speaker": null, "line": "and you feel like it's your responsibility now..."}, {"t": 2082.09, "speaker": null, "line": "Kristi, I..."}, {"t": 2082.09, "speaker": null, "line": "But I just need you"}, {"t": 2083.57, "speaker": null, "line": "to promise me, okay?"}, {"t": 2087.05, "speaker": null, "line": "If it falls apart, if you fall apart,"}, {"t": 2091.89, "speaker": null, "line": "just promise me, you'll come to me,"}, {"t": 2096.3, "speaker": null, "line": "you'll talk to me,"}, {"t": 2098.34, "speaker": null, "line": "you'll let me help."}, {"t": 2103.71, "speaker": null, "line": "I promise you."}, {"t": 2108.21, "speaker": null, "line": "Hey, I promise you."}, {"t": 2112.99, "speaker": null, "line": "Come here. Come on."}, {"t": 2122.5, "speaker": null, "line": "It's okay."}, {"t": 2126.27, "speaker": null, "line": "People just don't understand what it's like."}, {"t": 2129.14, "speaker": null, "line": "I mean, it's not like you can take a nickel"}, {"t": 2132.28, "speaker": null, "line": "and suddenly make it worth 10 cents!"}, {"t": 2135.2, "speaker": null, "line": "Aw, it doesn't matter. You know why?"}, {"t": 2138.75, "speaker": null, "line": "Because Jade is a genius. Jade'll figure it out. You..."}, {"t": 2143.98, "speaker": null, "line": "Let me tell you something,"}, {"t": 2145.13, "speaker": null, "line": "you have no idea how much pressure that is,"}, {"t": 2147.89, "speaker": null, "line": "to be the one that everybody"}, {"t": 2149.26, "speaker": null, "line": "just assumes can fix a..."}, {"t": 2153.27, "speaker": null, "line": "an unfixable problem!"}, {"t": 2155.56, "speaker": null, "line": "Oh, and then..."}, {"t": 2157.49, "speaker": null, "line": "Then, you've got Mr. Tea Cups sauntering in"}, {"t": 2160.11, "speaker": null, "line": "with his big white horse and his blue eyes and his,"}, {"t": 2165.7, "speaker": null, "line": "\"Oh, don't smoke weed, you degenerate.\""}, {"t": 2171.58, "speaker": null, "line": "Fine, fine. You know what? Fine."}, {"t": 2173.62, "speaker": null, "line": "You think you can fix this? Go ahead! Fix it!"}, {"t": 2175.71, "speaker": null, "line": "I'm just dying to see how it's done. Ha!"}, {"t": 2178.79, "speaker": null, "line": "Speaks Cantonese..."}, {"t": 2180.52, "speaker": null, "line": "You so much complain!"}, {"t": 2182.75, "speaker": null, "line": "Complain, complain!"}, {"t": 2184.7, "speaker": null, "line": "Stop complain!"}, {"t": 2186.53, "speaker": null, "line": "I'm sorry."}, {"t": 2186.53, "speaker": null, "line": "I'm sorry."}, {"t": 2189.93, "speaker": null, "line": "You need electric?"}, {"t": 2192.38, "speaker": null, "line": "Yeah."}, {"t": 2206.48, "speaker": null, "line": "The problem is you can't plug anything in."}, {"t": 2211.42, "speaker": null, "line": "I mean, it'd be one thing if it was just,"}, {"t": 2213.09, "speaker": null, "line": "you know, like a pan we could throw on the stove."}, {"t": 2217.0, "speaker": null, "line": "God knows,"}, {"t": 2218.13, "speaker": null, "line": "whatever's coming up through those wires is still..."}, {"t": 2230.51, "speaker": null, "line": "Holy shit. I know how to do it."}, {"t": 2236.64, "speaker": null, "line": "Hello?"}, {"t": 2237.74, "speaker": null, "line": "We're down here!"}, {"t": 2243.66, "speaker": null, "line": "Hi."}, {"t": 2245.19, "speaker": null, "line": "How did it go with the tower?"}, {"t": 2247.38, "speaker": null, "line": "Uh, good."}, {"t": 2248.97, "speaker": null, "line": "I think things are really shaping up."}, {"t": 2251.33, "speaker": null, "line": "You're a pretty bad liar."}, {"t": 2253.89, "speaker": null, "line": "Thanks. I'll add that to the list."}, {"t": 2257.94, "speaker": null, "line": "It's gonna work."}, {"t": 2263.48, "speaker": null, "line": "The tower, it's gonna work."}, {"t": 2266.42, "speaker": null, "line": "What's got you feeling so optimistic?"}, {"t": 2268.84, "speaker": null, "line": "I don't know."}, {"t": 2271.03, "speaker": null, "line": "I was just thinking about something Ethan said."}, {"t": 2273.6, "speaker": null, "line": "What was that?"}, {"t": 2274.95, "speaker": null, "line": "What if we were supposed to come here?"}, {"t": 2277.7, "speaker": null, "line": "I don't know, it's weird, but..."}, {"t": 2281.33, "speaker": null, "line": "back home, we never talked anymore."}, {"t": 2283.95, "speaker": null, "line": "We just..."}, {"t": 2286.16, "speaker": null, "line": "And now, we're together again,"}, {"t": 2287.69, "speaker": null, "line": "like, we're really together."}, {"t": 2289.84, "speaker": null, "line": "And it's..."}, {"t": 2292.6, "speaker": null, "line": "it's like Fatima said to me on my first night,"}, {"t": 2295.61, "speaker": null, "line": "\"If you climb up high enough,"}, {"t": 2297.34, "speaker": null, "line": "even a nightmare can look like a dream.\""}, {"t": 2299.87, "speaker": null, "line": "Wise words."}, {"t": 2303.5, "speaker": null, "line": "So, how about you forget about your tower for a little while"}, {"t": 2308.08, "speaker": null, "line": "and come help us dig our hole?"}, {"t": 2312.86, "speaker": null, "line": "Deal."}, {"t": 2342.55, "speaker": null, "line": "Whoa, whoa, whoa, whoa, whoa."}, {"t": 2345.05, "speaker": null, "line": "Hey, it's okay. It's okay. Come on."}, {"t": 2350.27, "speaker": null, "line": "It's okay. It's okay. Come on."}, {"t": 2353.45, "speaker": null, "line": "There. There, there you go."}, {"t": 2355.49, "speaker": null, "line": "There you go."}, {"t": 2357.78, "speaker": null, "line": "I wasn't sure you'd wake up."}, {"t": 2362.64, "speaker": null, "line": "Where are we?"}, {"t": 2364.56, "speaker": null, "line": "Don't worry. We're safe."}, {"t": 2369.81, "speaker": null, "line": "Is that...?"}, {"t": 2371.61, "speaker": null, "line": "Oh, yeah."}, {"t": 2372.81, "speaker": null, "line": "I, uh... finally managed to get one down,"}, {"t": 2376.78, "speaker": null, "line": "and, uh... this was inside."}, {"t": 2382.03, "speaker": null, "line": "What does it say?"}, {"t": 2383.8, "speaker": null, "line": "1864."}, {"t": 2387.19, "speaker": null, "line": "That's it."}, {"t": 2389.16, "speaker": null, "line": "And, from what I could tell,"}, {"t": 2392.34, "speaker": null, "line": "every bottle up there seems to have a slip of paper"}, {"t": 2394.47, "speaker": null, "line": "just like this."}, {"t": 2397.25, "speaker": null, "line": "I think we should go back."}, {"t": 2400.18, "speaker": null, "line": "What?"}, {"t": 2403.39, "speaker": null, "line": "The voice I heard,"}, {"t": 2405.42, "speaker": null, "line": "it was different this time."}, {"t": 2408.27, "speaker": null, "line": "It was a woman and..."}, {"t": 2411.75, "speaker": null, "line": "and she was screaming."}, {"t": 2414.12, "speaker": null, "line": "She said..."}, {"t": 2418.02, "speaker": null, "line": "She said that she was wrong,"}, {"t": 2420.49, "speaker": null, "line": "that we shouldn't have come, that there are things out here"}, {"t": 2424.83, "speaker": null, "line": "that are worse than the monsters."}, {"t": 2427.24, "speaker": null, "line": "She kept saying..."}, {"t": 2430.29, "speaker": null, "line": "What? She kept saying what?"}, {"t": 2432.64, "speaker": null, "line": "I don't know."}, {"t": 2435.51, "speaker": null, "line": "It doesn't make any sense."}, {"t": 2438.78, "speaker": null, "line": "She kept saying,"}, {"t": 2440.01, "speaker": null, "line": "\"Tell Mr. Fish and Loaves"}, {"t": 2442.19, "speaker": null, "line": "that I was wrong.\""}, {"t": 2446.24, "speaker": null, "line": "What?"}, {"t": 2453.94, "speaker": null, "line": "What is that?"}, {"t": 2455.91, "speaker": null, "line": "I don't know."}, {"t": 2472.88, "speaker": null, "line": "What's happening?"}, {"t": 2475.6, "speaker": null, "line": "I don't know."}, {"t": 2490.52, "speaker": null, "line": "There's drawings of scarecrows"}, {"t": 2494.62, "speaker": null, "line": "and bogeymen, giant spiders."}, {"t": 2496.65, "speaker": null, "line": "This is definitely a quest."}, {"t": 2503.63, "speaker": null, "line": "What is it?"}, {"t": 2505.34, "speaker": null, "line": "Keep digging, keep digging!"}, {"t": 2507.57, "speaker": null, "line": "I think I hit the bottom."}, {"t": 2509.05, "speaker": null, "line": "Oh, my God."}, {"t": 2510.29, "speaker": null, "line": "Here, here. Let me help."}, {"t": 2511.78, "speaker": null, "line": "Hey!"}, {"t": 2515.17, "speaker": null, "line": "Get in!"}, {"t": 2524.12, "speaker": null, "line": "Are you... are you..."}, {"t": 2537.94, "speaker": null, "line": "Hey, where's the talisman?"}, {"t": 2542.8, "speaker": null, "line": "W-Where's the talisman?"}, {"t": 2545.33, "speaker": null, "line": "Here!"}, {"t": 2562.08, "speaker": null, "line": "We shouldn't have come here."}, {"t": 2563.52, "speaker": null, "line": "Shh!"}, {"t": 2564.95, "speaker": null, "line": "We're okay. We're okay."}, {"t": 2567.46, "speaker": null, "line": "No."}, {"t": 2570.03, "speaker": null, "line": "I don't think we are."}]}