{"episode": "S02E02", "runtime_min": 44.9, "cues": 767, "words": 3256, "words_per_min": 72.5, "density_per_min": [127, 167, 84, 104, 109, 48, 0, 48, 72, 87, 132, 93, 135, 40, 94, 44, 155, 123, 50, 115, 169, 154, 92, 74, 23, 37, 76, 134, 64, 1, 39, 45, 64, 77, 176, 108, 58, 95, 24, 71, 51, 76, 95, 78, 21], "top_silences": [{"from": 328.6, "to": 433.1, "secs": 104.5}, {"from": 1704.1, "to": 1765.5, "secs": 61.4}], "speaker_lines": {}, "name_mentions": {"Boyd": 6, "Tabitha": 4, "Jim": 3, "Julie": 13, "Victor": 2, "Kenny": 1, "Donna": 2, "Kristi": 1, "Elgin": 3, "Fatima": 7, "Abby": 1, "Martin": 10, "Tom": 3}, "phrases": [{"phrase": "move move move", "count": 5}, {"phrase": "whoa whoa whoa", "count": 4}, {"phrase": "move move move move", "count": 4}, {"phrase": "gotta be quiet", "count": 3}, {"phrase": "run you need", "count": 3}, {"phrase": "wanna go home", "count": 3}, {"phrase": "shut the fuck", "count": 3}, {"phrase": "close the door", "count": 3}, {"phrase": "run run run", "count": 3}, {"phrase": "through the tree", "count": 2}, {"phrase": "man you gotta", "count": 2}, {"phrase": "what's your favorite", "count": 2}, {"phrase": "need to run", "count": 2}, {"phrase": "need to hide", "count": 2}, {"phrase": "bring them inside", "count": 2}, {"phrase": "what's what's goin'", "count": 2}, {"phrase": "please help us", "count": 2}, {"phrase": "need to close", "count": 2}, {"phrase": "let's go hurry", "count": 2}, {"phrase": "julie no julie", "count": 2}, {"phrase": "shall i say", "count": 2}, {"phrase": "say is calling", "count": 2}, {"phrase": "julie dad julie", "count": 2}, {"phrase": "dad who by", "count": 2}, {"phrase": "supposed to have lunch", "count": 2}], "dialogue": [{"t": 10.36, "speaker": null, "line": "Previously on From..."}, {"t": 11.92, "speaker": null, "line": "We have to turn around. We can't be here! Stop the bus!"}, {"t": 13.23, "speaker": null, "line": "Everyone please return to your seats!"}, {"t": 14.58, "speaker": null, "line": "Bad things are gonna happen if..."}, {"t": 17.32, "speaker": null, "line": "Stop the goddamn bus!"}, {"t": 19.32, "speaker": null, "line": "Donna!"}, {"t": 19.32, "speaker": null, "line": "What?"}, {"t": 21.46, "speaker": null, "line": "There is a bus parked outside the diner!"}, {"t": 26.72, "speaker": null, "line": "There's a woman trapped in the basement"}, {"t": 28.33, "speaker": null, "line": "of that house over there. We could use some help."}, {"t": 31.47, "speaker": null, "line": "Places don't just come apart like this!"}, {"t": 33.16, "speaker": null, "line": "Jim! Come!"}, {"t": 34.3, "speaker": null, "line": "Wait, we're almost there."}, {"t": 35.6, "speaker": null, "line": "Elgin?"}, {"t": 38.17, "speaker": null, "line": "I need some help over here!"}, {"t": 47.4, "speaker": null, "line": "Dad!"}, {"t": 48.74, "speaker": null, "line": "Julie!"}, {"t": 50.27, "speaker": null, "line": "In order to get us all three out safely,"}, {"t": 52.31, "speaker": null, "line": "you have to do it slowly"}, {"t": 54.71, "speaker": null, "line": "and you gotta do it right."}, {"t": 56.49, "speaker": null, "line": "Dad, the sun is about to go down."}, {"t": 58.27, "speaker": null, "line": "That's why you're gonna leave us here."}, {"t": 60.32, "speaker": null, "line": "Everyone on, right now."}, {"t": 61.76, "speaker": null, "line": "We're leaving."}, {"t": 61.76, "speaker": null, "line": "Hold on!"}, {"t": 63.15, "speaker": null, "line": "Start the..."}, {"t": 63.15, "speaker": null, "line": "No! No, no!"}, {"t": 64.33, "speaker": null, "line": "Donna!"}, {"t": 67.2, "speaker": null, "line": "Fatima, get back here!"}, {"t": 68.42, "speaker": null, "line": "We can't just leave them!"}, {"t": 69.89, "speaker": null, "line": "Fatima!"}, {"t": 69.89, "speaker": null, "line": "Fatima!"}, {"t": 71.64, "speaker": null, "line": "Inside the diner, now!"}, {"t": 75.25, "speaker": null, "line": "I love you too, Dad."}, {"t": 75.25, "speaker": null, "line": "We have to get inside!"}, {"t": 77.21, "speaker": null, "line": "Let's go. Inside. Inside!"}, {"t": 79.34, "speaker": null, "line": "They're here. We have to go."}, {"t": 82.3, "speaker": null, "line": "Where are we?"}, {"t": 82.3, "speaker": null, "line": "We're underneath the town."}, {"t": 84.17, "speaker": null, "line": "This is where the monsters live."}, {"t": 85.91, "speaker": null, "line": "This is where they sleep."}, {"t": 88.39, "speaker": null, "line": "There's a tunnel! Please, go all the way up."}, {"t": 90.35, "speaker": null, "line": "Go, go, go, go."}, {"t": 92.31, "speaker": null, "line": "Victor!"}, {"t": 94.27, "speaker": null, "line": "Part of me really wants to go to Iceland"}, {"t": 95.88, "speaker": null, "line": "with the most amazing guy I met"}, {"t": 97.4, "speaker": null, "line": "in the most fucked-up place imaginable."}, {"t": 99.27, "speaker": null, "line": "What does the other part want?"}, {"t": 100.53, "speaker": null, "line": "To go back and find out if"}, {"t": 102.41, "speaker": null, "line": "the woman I fell in love with waited for me."}, {"t": 109.81, "speaker": null, "line": "Anybody up there?"}, {"t": 112.02, "speaker": null, "line": "I can help you if you help me."}, {"t": 124.86, "speaker": null, "line": "You made it."}, {"t": 126.6, "speaker": null, "line": "What the..."}, {"t": 130.22, "speaker": null, "line": "We don't have much time."}, {"t": 132.35, "speaker": null, "line": "I need you to kill me."}, {"t": 146.58, "speaker": null, "line": "The fuck?"}, {"t": 147.89, "speaker": null, "line": "Where are we?"}, {"t": 150.89, "speaker": null, "line": "We had a deal."}, {"t": 152.98, "speaker": null, "line": "You said you would kill me."}, {"t": 157.03, "speaker": null, "line": "Jesus."}, {"t": 161.25, "speaker": null, "line": "Who did this to you?"}, {"t": 164.03, "speaker": null, "line": "Are you from the town?"}, {"t": 165.99, "speaker": null, "line": "What, the town...?"}, {"t": 168.6, "speaker": null, "line": "Yeah."}, {"t": 168.6, "speaker": null, "line": "Oh. The to..."}, {"t": 169.6, "speaker": null, "line": "Oh."}, {"t": 169.6, "speaker": null, "line": "The to..."}, {"t": 171.0, "speaker": null, "line": "I-I always thought the town was the worst part,"}, {"t": 174.61, "speaker": null, "line": "and then I went through the tree."}, {"t": 179.48, "speaker": null, "line": "Did you go through the tree?"}, {"t": 181.27, "speaker": null, "line": "Yeah."}, {"t": 184.79, "speaker": null, "line": "The tree, yeah."}, {"t": 187.36, "speaker": null, "line": "You go in one place, come out another."}, {"t": 191.06, "speaker": null, "line": "Sometimes you get stuck."}, {"t": 192.84, "speaker": null, "line": "Sometimes you get trapped."}, {"t": 195.72, "speaker": null, "line": "Now, that's when they get you."}, {"t": 199.5, "speaker": null, "line": "Who?"}, {"t": 202.07, "speaker": null, "line": "You... You have a kind face."}, {"t": 205.47, "speaker": null, "line": "What's your name?"}, {"t": 208.64, "speaker": null, "line": "I'm Boyd."}, {"t": 210.65, "speaker": null, "line": "I'm Martin."}, {"t": 215.48, "speaker": null, "line": "How long you been here, Martin?"}, {"t": 217.52, "speaker": null, "line": "Oh, it's... it's been a long... Ah!"}, {"t": 220.0, "speaker": null, "line": "Oh, I'm sorry."}, {"t": 221.53, "speaker": null, "line": "I used to try to count the days,"}, {"t": 223.44, "speaker": null, "line": "but I couldn't bear to count the years."}, {"t": 226.53, "speaker": null, "line": "It's been so long since I've seen kindness."}, {"t": 229.4, "speaker": null, "line": "That's why you have to go,"}, {"t": 230.97, "speaker": null, "line": "before they come back."}, {"t": 232.14, "speaker": null, "line": "I'm not leaving without you."}, {"t": 233.71, "speaker": null, "line": "Boyd."}, {"t": 236.97, "speaker": null, "line": "Wait, you... you're a Marine?"}, {"t": 239.8, "speaker": null, "line": "Semper fi."}, {"t": 242.85, "speaker": null, "line": "Leave no man behind. You help me, I help you."}, {"t": 246.68, "speaker": null, "line": "That's the way it goes, got it?"}, {"t": 248.12, "speaker": null, "line": "Boyd, if you want to help me,"}, {"t": 250.07, "speaker": null, "line": "then just kill me."}, {"t": 254.08, "speaker": null, "line": "Please."}, {"t": 256.08, "speaker": null, "line": "Everybody calm down!"}, {"t": 258.04, "speaker": null, "line": "Calm the fuck down!"}, {"t": 266.57, "speaker": null, "line": "Please, you haven't done anything yet you can't undo."}, {"t": 271.18, "speaker": null, "line": "This is just a big misunderstanding."}, {"t": 273.8, "speaker": null, "line": "People are upset, but if you'll let us go..."}, {"t": 276.75, "speaker": null, "line": "You wanna go?"}, {"t": 278.54, "speaker": null, "line": "You have no idea what's waiting out there."}, {"t": 281.98, "speaker": null, "line": "Where's Kristi?"}, {"t": 283.72, "speaker": null, "line": "She's in the back with the girl from the bus."}, {"t": 285.59, "speaker": null, "line": "The nurse."}, {"t": 285.59, "speaker": null, "line": "Sit down."}, {"t": 288.85, "speaker": null, "line": "You too, sit!"}, {"t": 291.99, "speaker": null, "line": "Okay."}, {"t": 295.43, "speaker": null, "line": "I know this is scary..."}, {"t": 298.51, "speaker": null, "line": "but we are not the enemy."}, {"t": 302.13, "speaker": null, "line": "The enemy's out there."}, {"t": 305.13, "speaker": null, "line": "Well, that's an odd thing to say..."}, {"t": 306.7, "speaker": null, "line": "Please, just let me explain."}, {"t": 310.4, "speaker": null, "line": "Okay."}, {"t": 311.79, "speaker": null, "line": "Okay, let's start"}, {"t": 313.18, "speaker": null, "line": "with the tree you saw in the road."}, {"t": 317.49, "speaker": null, "line": "How did you know about the tree?"}, {"t": 320.45, "speaker": null, "line": "Everyone sees the tree."}, {"t": 325.8, "speaker": null, "line": "\" plays]"}, {"t": 445.75, "speaker": null, "line": "How much further to town?"}, {"t": 452.54, "speaker": null, "line": "It's too far. Over there!"}, {"t": 454.63, "speaker": null, "line": "We can hide in there till morning."}, {"t": 456.15, "speaker": null, "line": "Yeah."}, {"t": 457.85, "speaker": null, "line": "Okay."}, {"t": 461.59, "speaker": null, "line": "Go in."}, {"t": 463.94, "speaker": null, "line": "We have to be quiet."}, {"t": 466.81, "speaker": null, "line": "There's no talisman in here."}, {"t": 474.04, "speaker": null, "line": "Whose stuff is this?"}, {"t": 475.3, "speaker": null, "line": "This is mine."}, {"t": 477.74, "speaker": null, "line": "Why is it here?"}, {"t": 480.04, "speaker": null, "line": "I come here sometimes."}, {"t": 487.23, "speaker": null, "line": "I have some food for us."}, {"t": 498.02, "speaker": null, "line": "Mari."}, {"t": 500.59, "speaker": null, "line": "How could you?"}, {"t": 505.37, "speaker": null, "line": "We were supposed to have lunch."}, {"t": 509.07, "speaker": null, "line": "I was on my way to meet you. We were supposed to have lunch."}, {"t": 514.08, "speaker": null, "line": "I know."}, {"t": 515.34, "speaker": null, "line": "Have you been here this whole time?"}, {"t": 517.87, "speaker": null, "line": "It's been six months. You never called, you never..."}, {"t": 525.7, "speaker": null, "line": "You know, your parents and I..."}, {"t": 530.36, "speaker": null, "line": "we went to the police."}, {"t": 539.19, "speaker": null, "line": "Mari, you don't understand..."}, {"t": 540.28, "speaker": null, "line": "Bullshit."}, {"t": 542.63, "speaker": null, "line": "This whole time you've been less than two hours away,"}, {"t": 547.07, "speaker": null, "line": "with these people,"}, {"t": 549.24, "speaker": null, "line": "with shotguns,"}, {"t": 551.38, "speaker": null, "line": "that fucking woman."}, {"t": 555.16, "speaker": null, "line": "It's like you've joined some fucking cult."}, {"t": 558.25, "speaker": null, "line": "I gotta get out of here."}, {"t": 559.82, "speaker": null, "line": "You can't leave the diner."}, {"t": 561.26, "speaker": null, "line": "Get out of my way."}, {"t": 562.78, "speaker": null, "line": "You need to listen to me, okay?"}, {"t": 564.96, "speaker": null, "line": "You don't get to tell me what I can and cannot do."}, {"t": 576.27, "speaker": null, "line": "Look."}, {"t": 579.75, "speaker": null, "line": "I know you're hurt."}, {"t": 581.28, "speaker": null, "line": "Mm-hm."}, {"t": 582.84, "speaker": null, "line": "And that this is beyond fucked up."}, {"t": 587.89, "speaker": null, "line": "But I-I just need you to listen to me, okay?"}, {"t": 595.29, "speaker": null, "line": "This place."}, {"t": 602.12, "speaker": null, "line": "It isn't what you think."}, {"t": 605.74, "speaker": null, "line": "How you doing over there, Jim?"}, {"t": 608.26, "speaker": null, "line": "I think I busted a rib."}, {"t": 610.74, "speaker": null, "line": "It's getting hard to breathe."}, {"t": 612.31, "speaker": null, "line": "Just take it slow."}, {"t": 615.09, "speaker": null, "line": "We'll be okay."}, {"t": 618.05, "speaker": null, "line": "Have you ever done this before?"}, {"t": 620.79, "speaker": null, "line": "Spent the night hiding?"}, {"t": 623.97, "speaker": null, "line": "Would it make you feel better if I said yes?"}, {"t": 632.24, "speaker": null, "line": "What the fuck. Fuck!"}, {"t": 635.72, "speaker": null, "line": "I can't move!"}, {"t": 637.38, "speaker": null, "line": "Help!"}, {"t": 638.38, "speaker": null, "line": "It's Rick, right?"}, {"t": 641.03, "speaker": null, "line": "Brick! My name's Brick."}, {"t": 642.51, "speaker": null, "line": "Okay, you gotta calm down, buddy."}, {"t": 644.25, "speaker": null, "line": "Hey, you need to get me out of here, okay? Please."}, {"t": 646.82, "speaker": null, "line": "Brick. Brick."}, {"t": 646.82, "speaker": null, "line": "My chest hurts."}, {"t": 649.3, "speaker": null, "line": "Brick?"}, {"t": 649.3, "speaker": null, "line": "Yeah?"}, {"t": 650.52, "speaker": null, "line": "You gotta stay quiet, man."}, {"t": 652.26, "speaker": null, "line": "I'm coming over to you, buddy, okay?"}, {"t": 656.09, "speaker": null, "line": "I ca... I can't breathe! I can't breathe!"}, {"t": 657.87, "speaker": null, "line": "Yes, you can."}, {"t": 659.4, "speaker": null, "line": "You're talkin', right? That means you can breathe."}, {"t": 661.84, "speaker": null, "line": "Just nice and slow."}, {"t": 665.23, "speaker": null, "line": "Okay? Tom?"}, {"t": 668.23, "speaker": null, "line": "Almost there."}, {"t": 671.8, "speaker": null, "line": "Stop!"}, {"t": 677.81, "speaker": null, "line": "Come on, man, you gotta stop moving."}, {"t": 684.25, "speaker": null, "line": "Hey, look at me."}, {"t": 687.38, "speaker": null, "line": "You see me?"}, {"t": 689.12, "speaker": null, "line": "Yeah. Yeah, I can see you."}, {"t": 692.95, "speaker": null, "line": "Just, um, look I'm, uh,"}, {"t": 694.3, "speaker": null, "line": "not really good in tight spaces, all right?"}, {"t": 697.39, "speaker": null, "line": "It's all right."}, {"t": 698.87, "speaker": null, "line": "Just, you gotta be quiet."}, {"t": 701.44, "speaker": null, "line": "I'm right here. We're both right here, okay?"}, {"t": 704.4, "speaker": null, "line": "We're gonna get outta this."}, {"t": 707.18, "speaker": null, "line": "We just gotta stay calm and not make things worse."}, {"t": 710.93, "speaker": null, "line": "Most of all, we gotta be quiet."}, {"t": 716.24, "speaker": null, "line": "As quiet as we can."}, {"t": 718.28, "speaker": null, "line": "Why?"}, {"t": 727.29, "speaker": null, "line": "Come on, man."}, {"t": 729.08, "speaker": null, "line": "There's gotta be something."}, {"t": 733.3, "speaker": null, "line": "Even if you get me free, then what?"}, {"t": 736.34, "speaker": null, "line": "I don't think I can make it to town."}, {"t": 738.35, "speaker": null, "line": "Then I'll carry you. Huh?"}, {"t": 740.61, "speaker": null, "line": "Once we get back to town, look, we got... we got people."}, {"t": 743.44, "speaker": null, "line": "A doctor. She can help you."}, {"t": 744.92, "speaker": null, "line": "Hey, look."}, {"t": 746.31, "speaker": null, "line": "You see this?"}, {"t": 749.14, "speaker": null, "line": "I found these in the forest."}, {"t": 751.01, "speaker": null, "line": "They protect us. Keep us safe."}, {"t": 753.06, "speaker": null, "line": "They won't be able to hurt you there."}, {"t": 755.14, "speaker": null, "line": "You think... you think those things that come out"}, {"t": 757.93, "speaker": null, "line": "of the forest at night did this?"}, {"t": 760.59, "speaker": null, "line": "They're just the tip of the spear."}, {"t": 762.89, "speaker": null, "line": "Hey, how 'bout we change the subject, huh?"}, {"t": 765.68, "speaker": null, "line": "Hey, Martin, where you from?"}, {"t": 767.2, "speaker": null, "line": "A small town. Millbrook."}, {"t": 769.38, "speaker": null, "line": "Where?"}, {"t": 770.55, "speaker": null, "line": "Millbrook, huh?"}, {"t": 771.99, "speaker": null, "line": "You're wa... wasting time."}, {"t": 777.43, "speaker": null, "line": "Oh, God."}, {"t": 779.21, "speaker": null, "line": "They're coming."}, {"t": 779.21, "speaker": null, "line": "What the..."}, {"t": 784.57, "speaker": null, "line": "You don't have time, Boyd."}, {"t": 788.26, "speaker": null, "line": "There's darkness in the forest."}, {"t": 791.14, "speaker": null, "line": "Nightmares you can't even begin to imagine."}, {"t": 794.18, "speaker": null, "line": "Things we were never meant to see. Things that..."}, {"t": 799.1, "speaker": null, "line": "You have to get out before the music stops."}, {"t": 842.71, "speaker": null, "line": "Don't."}, {"t": 845.54, "speaker": null, "line": "The more attention you draw to the house,"}, {"t": 847.28, "speaker": null, "line": "the more likely those things are to go looking around."}, {"t": 850.02, "speaker": null, "line": "I can't just sit here doing nothing."}, {"t": 851.5, "speaker": null, "line": "That is exactly what you're gonna do."}, {"t": 855.55, "speaker": null, "line": "You... Come on, sit down."}, {"t": 868.22, "speaker": null, "line": "Julie, your dad's best chance right now is to stay"}, {"t": 871.3, "speaker": null, "line": "exactly where he is until the morning."}, {"t": 876.09, "speaker": null, "line": "People used to do it all the time here."}, {"t": 877.7, "speaker": null, "line": "They hid."}, {"t": 881.05, "speaker": null, "line": "That's how Sheriff Boyd and his family"}, {"t": 882.75, "speaker": null, "line": "survived the first night."}, {"t": 886.58, "speaker": null, "line": "I know."}, {"t": 888.32, "speaker": null, "line": "Hey, look, all we can do right now is wait."}, {"t": 896.55, "speaker": null, "line": "Do you want some tea?"}, {"t": 907.08, "speaker": null, "line": "What, uh... What's your favorite book?"}, {"t": 911.3, "speaker": null, "line": "What?"}, {"t": 912.22, "speaker": null, "line": "You do read, right?"}, {"t": 914.26, "speaker": null, "line": "What's your favorite book?"}, {"t": 916.18, "speaker": null, "line": "You're just trying to distract me."}, {"t": 918.83, "speaker": null, "line": "Yeah. Yeah, maybe."}, {"t": 923.05, "speaker": null, "line": "But you still gotta answer the question."}, {"t": 936.59, "speaker": null, "line": "Just when I thought life was all out of surprises."}, {"t": 959.65, "speaker": null, "line": "Hello?"}, {"t": 961.66, "speaker": null, "line": "Anybody here?"}, {"t": 964.4, "speaker": null, "line": "This is a weird gas station."}, {"t": 967.66, "speaker": null, "line": "Yeah."}, {"t": 971.36, "speaker": null, "line": "This whole fuckin' place is weird."}, {"t": 973.15, "speaker": null, "line": "It's like we drove into a goddamn acid trip."}, {"t": 975.67, "speaker": null, "line": "There are worse places to be stuck, I suppose."}, {"t": 992.16, "speaker": null, "line": "Can anybody hear me?"}, {"t": 995.08, "speaker": null, "line": "God dammit, where did they all go?"}, {"t": 997.43, "speaker": null, "line": "We need to go back inside."}, {"t": 998.74, "speaker": null, "line": "What? No."}, {"t": 998.74, "speaker": null, "line": "Come on."}, {"t": 1000.22, "speaker": null, "line": "No. We have to find them. We can't just leave"}, {"t": 1001.61, "speaker": null, "line": "those people out here."}, {"t": 1001.61, "speaker": null, "line": "Look, we tried. We tried."}, {"t": 1002.96, "speaker": null, "line": "There's nothing more we can do. Okay? Come on."}, {"t": 1005.57, "speaker": null, "line": "Hey! If you were on the bus,"}, {"t": 1007.18, "speaker": null, "line": "if you can hear me, you have to run."}, {"t": 1008.79, "speaker": null, "line": "You have to run and be as quiet as you can."}, {"t": 1010.84, "speaker": null, "line": "There are things out here, things that if they find you,"}, {"t": 1013.4, "speaker": null, "line": "they'll... if somebody calls for you..."}, {"t": 1015.45, "speaker": null, "line": "Okay, inside!"}, {"t": 1015.45, "speaker": null, "line": "Do not answer!"}, {"t": 1016.84, "speaker": null, "line": "Inside, now! Inside, now!"}, {"t": 1018.19, "speaker": null, "line": "If somebody calls for you do not answer!"}, {"t": 1033.9, "speaker": null, "line": "You're spoiling all the fun."}, {"t": 1038.47, "speaker": null, "line": "Fuck!"}, {"t": 1040.43, "speaker": null, "line": "No, Fatima! No, stop!"}, {"t": 1044.48, "speaker": null, "line": "Hey!"}, {"t": 1045.61, "speaker": null, "line": "Fatima!"}, {"t": 1049.18, "speaker": null, "line": "Oh, no."}, {"t": 1050.4, "speaker": null, "line": "Hey! Hey! Hey!"}, {"t": 1053.44, "speaker": null, "line": "You need to run! You need to hide!"}, {"t": 1054.92, "speaker": null, "line": "Fatima, hey, hey, baby."}, {"t": 1057.19, "speaker": null, "line": "Baby, come away from the window, okay?"}, {"t": 1058.75, "speaker": null, "line": "Hey! You should run!"}, {"t": 1059.93, "speaker": null, "line": "You need run! You need to hide!"}, {"t": 1061.67, "speaker": null, "line": "You have to get inside!"}, {"t": 1063.37, "speaker": null, "line": "Hey! They're not listening!"}, 