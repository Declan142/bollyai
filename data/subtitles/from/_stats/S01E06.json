{"episode": "S01E06", "runtime_min": 47.0, "cues": 661, "words": 3583, "words_per_min": 76.2, "density_per_min": [157, 98, 93, 100, 107, 102, 55, 4, 0, 0, 146, 118, 166, 78, 92, 105, 38, 110, 125, 90, 3, 140, 73, 77, 55, 92, 66, 26, 75, 114, 133, 54, 24, 42, 36, 43, 21, 100, 121, 90, 67, 97, 141, 43, 39, 32, 14], "top_silences": [{"from": 472.1, "to": 600.5, "secs": 128.4}, {"from": 388.8, "to": 469.6, "secs": 80.8}, {"from": 2729.2, "to": 2810.0, "secs": 80.8}, {"from": 2604.1, "to": 2682.5, "secs": 78.4}], "speaker_lines": {}, "name_mentions": {"Boyd": 4, "Tabitha": 3, "Jim": 1, "Julie": 1, "Ethan": 2, "Sara": 12, "Kenny": 3, "Kristi": 4, "Jade": 5, "Nathan": 6}, "phrases": [{"phrase": "find a way", "count": 3}, {"phrase": "able to find", "count": 2}, {"phrase": "i'm not gonna", "count": 2}, {"phrase": "ran off into", "count": 2}, {"phrase": "into the woods", "count": 2}, {"phrase": "having a hard", "count": 2}, {"phrase": "there's no wire", "count": 2}, {"phrase": "what's wrong nothing", "count": 2}, {"phrase": "think he needs", "count": 2}, {"phrase": "seventy three books", "count": 2}, {"phrase": "hello is anybody", "count": 2}, {"phrase": "said they watched", "count": 2}, {"phrase": "there's a lot", "count": 2}, {"phrase": "bracelet i made", "count": 2}, {"phrase": "off into the woods", "count": 2}, {"phrase": "having a hard time", "count": 2}, {"phrase": "people of this town", "count": 2}], "dialogue": [{"t": 9.02, "speaker": null, "line": "Previously on From..."}, {"t": 10.33, "speaker": null, "line": "I feel like I'm hanging on by a thread here."}, {"t": 13.33, "speaker": null, "line": "Those things, they never run."}, {"t": 15.42, "speaker": null, "line": "They know there's only so many places we can go."}, {"t": 18.38, "speaker": null, "line": "I think we're running out of spaces on the board, Sheriff."}, {"t": 21.47, "speaker": null, "line": "I wish you had the luxury of grief, but you don't, Boyd."}, {"t": 23.34, "speaker": null, "line": "These people need you."}, {"t": 26.34, "speaker": null, "line": "You need to be the one to lead these people home."}, {"t": 29.26, "speaker": null, "line": "'Cause if you don't, she died for nothing."}, {"t": 31.78, "speaker": null, "line": "Come on."}, {"t": 32.67, "speaker": null, "line": "Started getting tremors in my hand a few weeks back,"}, {"t": 35.26, "speaker": null, "line": "which means the clock is officially ticking,"}, {"t": 38.69, "speaker": null, "line": "but I have this crazy idea that might actually work and..."}, {"t": 40.83, "speaker": null, "line": "And if it does,"}, {"t": 42.79, "speaker": null, "line": "I might be able to find a way to get these people home."}, {"t": 46.05, "speaker": null, "line": "Something here is missing. We just can't see it yet."}, {"t": 49.14, "speaker": null, "line": "I need something to write with."}, {"t": 50.53, "speaker": null, "line": "Ask every question, right?"}, {"t": 53.88, "speaker": null, "line": "I don't just sit around"}, {"t": 55.62, "speaker": null, "line": "fucking accepting the world as it is!"}, {"t": 58.19, "speaker": null, "line": "Someone is doing this,"}, {"t": 60.19, "speaker": null, "line": "and I'm not gonna rest until I figure out how."}, {"t": 61.94, "speaker": null, "line": "Jade!"}, {"t": 67.46, "speaker": null, "line": "I really like you,"}, {"t": 69.73, "speaker": null, "line": "and what's about to happen, it's gonna save everyone."}, {"t": 73.64, "speaker": null, "line": "Where's my mom? I want my mom!"}, {"t": 75.64, "speaker": null, "line": "You're doing this for her!"}, {"t": 77.52, "speaker": null, "line": "Let him go."}, {"t": 79.56, "speaker": null, "line": "They told me this was the last one,"}, {"t": 80.91, "speaker": null, "line": "then everyone gets to go home!"}, {"t": 83.87, "speaker": null, "line": "Ethan, run!"}, {"t": 83.87, "speaker": null, "line": "No!"}, {"t": 85.09, "speaker": null, "line": "You don't understand!"}, {"t": 87.0, "speaker": null, "line": "Nathan!"}, {"t": 87.0, "speaker": null, "line": "Nathan."}, {"t": 89.01, "speaker": null, "line": "Nathan, please!"}, {"t": 92.92, "speaker": null, "line": "Where is she?"}, {"t": 94.92, "speaker": null, "line": "She ran off into the woods."}, {"t": 96.54, "speaker": null, "line": "And?"}, {"t": 98.75, "speaker": null, "line": "And if she comes back before dark, then we'll handle it."}, {"t": 101.58, "speaker": null, "line": "And if she doesn't?"}, {"t": 103.76, "speaker": null, "line": "If she doesn't, then it's handled."}, {"t": 127.65, "speaker": null, "line": "Chaos and faith,"}, {"t": 131.74, "speaker": null, "line": "that is the duality of our existence,"}, {"t": 135.27, "speaker": null, "line": "from the moment we first arrive,"}, {"t": 137.79, "speaker": null, "line": "and not simply here in this town..."}, {"t": 143.1, "speaker": null, "line": "...but in this world, in this life."}, {"t": 147.11, "speaker": null, "line": "From the moment we open our newborn eyes,"}, {"t": 149.98, "speaker": null, "line": "we are faced with a chaos we cannot even begin to understand."}, {"t": 154.81, "speaker": null, "line": "And how do we respond?"}, {"t": 157.34, "speaker": null, "line": "What is the very first sound we make?"}, {"t": 160.95, "speaker": null, "line": "We cry out."}, {"t": 164.12, "speaker": null, "line": "We plead for answers,"}, {"t": 167.48, "speaker": null, "line": "before we even have words to give voice to the questions."}, {"t": 172.39, "speaker": null, "line": "That's how we begin our journey through this world -"}, {"t": 175.88, "speaker": null, "line": "terrified,"}, {"t": 177.88, "speaker": null, "line": "confused."}, {"t": 181.27, "speaker": null, "line": "And so, we search, and we strive,"}, {"t": 184.27, "speaker": null, "line": "and we stumble through the chaos."}, {"t": 187.19, "speaker": null, "line": "We spend our lives looking for signs that somewhere,"}, {"t": 191.8, "speaker": null, "line": "somehow there's a meaning,"}, {"t": 195.29, "speaker": null, "line": "a purpose to it all."}, {"t": 198.94, "speaker": null, "line": "And then, one day, we find our faith."}, {"t": 203.38, "speaker": null, "line": "Our faith that we are each here in this world,"}, {"t": 207.17, "speaker": null, "line": "in this place,"}, {"t": 209.39, "speaker": null, "line": "as part of God's mysterious plan."}, {"t": 213.35, "speaker": null, "line": "In our faith, we understand the chaos is the meaning."}, {"t": 218.09, "speaker": null, "line": "It is in our struggle,"}, {"t": 220.49, "speaker": null, "line": "in our search, that we find our purpose."}, {"t": 227.32, "speaker": null, "line": "\"Trust in the Lord with all thine heart"}, {"t": 230.36, "speaker": null, "line": "and lean not unto thine own understanding.\""}, {"t": 235.28, "speaker": null, "line": "Amen."}, {"t": 235.28, "speaker": null, "line": "Amen."}, {"t": 249.34, "speaker": null, "line": "It's always... it's always nice to see new faces."}, {"t": 252.52, "speaker": null, "line": "Yeah, I'm, um... I just came by to give you this."}, {"t": 258.09, "speaker": null, "line": "We've been packing up the other family's stuff."}, {"t": 261.09, "speaker": null, "line": "I figured they were yours."}, {"t": 264.01, "speaker": null, "line": "Yeah."}, {"t": 266.75, "speaker": null, "line": "How's Ethan doing?"}, {"t": 270.01, "speaker": null, "line": "Well, he's, um..."}, {"t": 272.36, "speaker": null, "line": "He's scared and confused."}, {"t": 275.54, "speaker": null, "line": "He doesn't understand why Sara would try to hurt him."}, {"t": 277.72, "speaker": null, "line": "Mm."}, {"t": 280.2, "speaker": null, "line": "Has anyone seen her?"}, {"t": 281.98, "speaker": null, "line": "Not since she ran off into the woods."}, {"t": 284.37, "speaker": null, "line": "Mm."}, {"t": 285.99, "speaker": null, "line": "I ran after her, but..."}, {"t": 288.07, "speaker": null, "line": "my knees aren't quite what they used to be, I'm afraid."}, {"t": 291.9, "speaker": null, "line": "Do you think she's still alive?"}, {"t": 294.99, "speaker": null, "line": "It's unlikely she survived the night."}, {"t": 296.43, "speaker": null, "line": "Those Bible passages, did you..."}, {"t": 299.83, "speaker": null, "line": "Did you write those from memory?"}, {"t": 302.26, "speaker": null, "line": "Yeah. Word for word."}, {"t": 306.31, "speaker": null, "line": "It tends to stick."}, {"t": 312.14, "speaker": null, "line": "Um, what did you really come here to ask me, Tabitha?"}, {"t": 323.89, "speaker": null, "line": "How do you know any of this is real?"}, {"t": 327.9, "speaker": null, "line": "I mean..."}, {"t": 330.46, "speaker": null, "line": "It sounds crazy, but are we dead? Are we alive?"}, {"t": 333.38, "speaker": null, "line": "I..."}, {"t": 336.95, "speaker": null, "line": "Would it matter?"}, {"t": 339.34, "speaker": null, "line": "I mean, for argument's sake, let's say we're dead,"}, {"t": 342.43, "speaker": null, "line": "and we're all stuck here together in some strange,"}, {"t": 345.0, "speaker": null, "line": "tormented purgatory."}, {"t": 346.52, "speaker": null, "line": "What would be different? We'd still be stuck."}, {"t": 351.14, "speaker": null, "line": "We'd still be searching for a way to go home."}, {"t": 353.27, "speaker": null, "line": "All that would change is the home we're searching for."}, {"t": 357.45, "speaker": null, "line": "Yeah."}, {"t": 359.97, "speaker": null, "line": "I mean, I'm guessing I'm not the first person"}, {"t": 361.93, "speaker": null, "line": "to come to you with that question."}, {"t": 363.32, "speaker": null, "line": "Well, let's just say"}, {"t": 365.15, "speaker": null, "line": "I've had plenty of chances to work on my answer."}, {"t": 367.07, "speaker": null, "line": "Yeah."}, {"t": 369.2, "speaker": null, "line": "But if it's any consolation to you,"}, {"t": 371.64, "speaker": null, "line": "you were already here when your vehicle crashed."}, {"t": 375.16, "speaker": null, "line": "You're alive, Tabitha. Your family's alive."}, {"t": 379.21, "speaker": null, "line": "So you can scratch that question off your list."}, {"t": 384.26, "speaker": null, "line": "Yeah."}, {"t": 386.3, "speaker": null, "line": "Bye."}, {"t": 387.43, "speaker": null, "line": "Yeah."}, {"t": 469.6, "speaker": null, "line": "We need to talk."}, {"t": 600.52, "speaker": null, "line": "You all right?"}, {"t": 602.48, "speaker": null, "line": "Yeah, it..."}, {"t": 604.65, "speaker": null, "line": "I'm having a hard time wrapping my brain around it, I guess."}, {"t": 608.13, "speaker": null, "line": "I mean, it's Sara, you know?"}, {"t": 610.7, "speaker": null, "line": "She was always so thoughtful, so nice."}, {"t": 614.23, "speaker": null, "line": "How's your mom taking it?"}, {"t": 614.23, "speaker": null, "line": "It's hard."}, {"t": 617.27, "speaker": null, "line": "You know, Sara was kind of like the daughter she never had."}, {"t": 623.76, "speaker": null, "line": "I been thinking about what you said the other day,"}, {"t": 626.72, "speaker": null, "line": "about running out of room on the board."}, {"t": 629.11, "speaker": null, "line": "I was upset."}, {"t": 630.24, "speaker": null, "line": "Well, it doesn't mean you're wrong."}, {"t": 633.25, "speaker": null, "line": "Something's changing here. It's like..."}, {"t": 636.16, "speaker": null, "line": "like something's slipping away."}, {"t": 638.29, "speaker": null, "line": "The other night, the talisman worked out in the RV,"}, {"t": 641.56, "speaker": null, "line": "same way it does in the houses."}, {"t": 643.52, "speaker": null, "line": "And?"}, {"t": 645.69, "speaker": null, "line": "And I've been thinking that the only reason"}, {"t": 647.96, "speaker": null, "line": "we haven't pushed further into the forest"}, {"t": 650.92, "speaker": null, "line": "is we didn't know whether the talisman"}, {"t": 653.7, "speaker": null, "line": "would protect us out there the same way it does in the town."}, {"t": 657.57, "speaker": null, "line": "So..."}, {"t": 659.23, "speaker": null, "line": "I'm putting together some supplies."}, {"t": 661.19, "speaker": null, "line": "I'm gonna take the talisman"}, {"t": 662.88, "speaker": null, "line": "and go out in the forest and I'm gonna see..."}, {"t": 666.1, "speaker": null, "line": "Hey! Hey, hey, hey, hey!"}, {"t": 668.72, "speaker": null, "line": "Kenny, what..."}, {"t": 670.67, "speaker": null, "line": "Hey! You don't walk away when I'm talking to you!"}, {"t": 673.76, "speaker": null, "line": "Are you going alone?"}, {"t": 675.24, "speaker": null, "line": "Yeah."}, {"t": 676.59, "speaker": null, "line": "And how far are you going?"}, {"t": 678.64, "speaker": null, "line": "As far as it'll take me."}, {"t": 680.25, "speaker": null, "line": "I'm doin' this to find a way out,"}, {"t": 682.73, "speaker": null, "line": "find a way home. Isn't that the point?"}, {"t": 685.86, "speaker": null, "line": "Make sure we all get home?"}, {"t": 686.69, "speaker": null, "line": "Honestly?"}, {"t": 688.26, "speaker": null, "line": "I'm not sure there is a point anymore."}, {"t": 691.35, "speaker": null, "line": "But if you're in that much of a hurry to fuckin' die,"}, {"t": 694.22, "speaker": null, "line": "you should just go and do it."}, {"t": 696.26, "speaker": null, "line": "Okay?"}, {"t": 708.41, "speaker": null, "line": "I got everything packed up."}, {"t": 709.76, "speaker": null, "line": "It's ready to go to storage."}, {"t": 711.28, "speaker": null, "line": "Oh, okay."}, {"t": 715.59, "speaker": null, "line": "What are you up to?"}, {"t": 720.11, "speaker": null, "line": "Look."}, {"t": 725.21, "speaker": null, "line": "There's no wire in here."}, {"t": 726.64, "speaker": null, "line": "What?"}, {"t": 727.82, "speaker": null, "line": "In the cord."}, {"t": 730.3, "speaker": null, "line": "When you want to splice a wire,"}, {"t": 732.43, "speaker": null, "line": "you gotta strip away the coating to get at the wire inside."}, {"t": 733.95, "speaker": null, "line": "But there's no wire. This is..."}, {"t": 736.78, "speaker": null, "line": "You know, it's not actually a wire."}, {"t": 738.22, "speaker": null, "line": "And the plug?"}, {"t": 740.27, "speaker": null, "line": "Look."}, {"t": 742.09, "speaker": null, "line": "Look."}, {"t": 744.97, "speaker": null, "line": "The outlets, none of it makes any sense."}, {"t": 748.27, "speaker": null, "line": "I mean, these lamps, they shouldn't work."}, {"t": 749.75, "speaker": null, "line": "Hello!"}, {"t": 751.49, "speaker": null, "line": "Ah, you, uh, rollercoaster guy,"}, {"t": 753.5, "speaker": null, "line": "I need your help."}, {"t": 753.5, "speaker": null, "line": "You don't knock?"}, {"t": 756.02, "speaker": null, "line": "I'm sorry, would you like me to take off my shoes too?"}, {"t": 758.07, "speaker": null, "line": "You noticed the wire thing too, huh? Fucking weird, right?"}, {"t": 760.42, "speaker": null, "line": "You're that asshole that almost killed us."}, {"t": 764.99, "speaker": null, "line": "Okay, look, first of all, I wasn't driving."}, {"t": 767.29, "speaker": null, "line": "Second, my best friend,"}, {"t": 769.38, "speaker": null, "line": "who I've known since fourth grade, is dead. All right?"}, {"t": 771.43, "speaker": null, "line": "He's not walking around with A little boo-boo on his leg."}, {"t": 773.6, "speaker": null, "line": "So, how about we just call that one even, okay?"}, {"t": 775.6, "speaker": null, "line": "Now, you guys wanna play house or do you wanna go home?"}, {"t": 778.96, "speaker": null, "line": "Because I have an idea."}, {"t": 783.87, "speaker": null, "line": "Did you know there's not a single copy"}, {"t": 785.61, "speaker": null, "line": "of the Bible in town?"}, {"t": 788.79, "speaker": null, "line": "I mean, in our little traveler's library in the diner,"}, {"t": 792.1, "speaker": null, "line": "there's at least a dozen Robert Ludlum and Judy Blume novels,"}, {"t": 796.28, "speaker": null, "line": "yet..."}, {"t": 798.89, "speaker": null, "line": "not a single copy of the world's most popular book."}, {"t": 807.55, "speaker": null, "line": "I imagine you wonder why you're here."}, {"t": 811.68, "speaker": null, "line": "You've done such unspeakable things."}, {"t": 818.95, "speaker": null, "line": "And by the rules of the town, you should be in the box."}, {"t": 831.83, "speaker": null, "line": "Nathan told me about the voices."}, {"t": 838.28, "speaker": null, "line": "It's okay."}, {"t": 846.59, "speaker": null, "line": "Sara, what if I were to tell you"}, {"t": 851.64, "speaker": null, "line": "that despite the horrible things you've done,"}, {"t": 855.6, "speaker": null, "line": "you can still help the people of this town?"}, {"t": 858.77, "speaker": null, "line": "You could still do something good."}, {"t": 862.43, "speaker": null, "line": "I think Nathan would like that, don't you?"}, {"t": 866.83, "speaker": null, "line": "Yeah?"}, {"t": 870.35, "speaker": null, "line": "Good."}, {"t": 877.79, "speaker": null, "line": "Those are pretty."}, {"t": 879.32, "speaker": null, "line": "Right?"}, {"t": 880.75, "speaker": null, "line": "You have a good eye, Miss Matthews."}, {"t": 882.1, "speaker": null, "line": "Oh, I just found them like this."}, {"t": 883.5, "speaker": null, "line": "Like what?"}, {"t": 884.97, "speaker": null, "line": "Arranged like this."}, {"t": 887.19, "speaker": null, "line": "They were on the porch on the side of the house."}, {"t": 889.81, "speaker": null, "line": "Huh."}, {"t": 892.07, "speaker": null, "line": "Well, it seems we have a phantom florist running around."}, {"t": 895.59, "speaker": null, "line": "Come on. It's laundry day."}, {"t": 898.42, "speaker": null, "line": "Come on."}, {"t": 904.78, "speaker": null, "line": "Ow!"}, {"t": 906.0, "speaker": null, "line": "Motherfucker! Come on!"}, {"t": 908.61, "speaker": null, "line": "Ugh."}, {"t": 912.09, "speaker": null, "line": "These people are ding-dongs. They stripped the car."}, {"t": 914.13, "speaker": null, "line": "They leave behind the only parts that actually matter."}, {"t": 916.44, "speaker": null, "line": "They're not all ding-dongs."}, {"t": 917.53, "speaker": null, "line": "Battery's gone."}, {"t": 918.49, "speaker": null, "line": "Huh?"}, {"t": 919.97, "speaker": null, "line": "I said, the battery is gone."}, {"t": 923.97, "speaker": null, "line": "That means we gotta go back to town."}, {"t": 926.02, "speaker": null, "line": "Wait, just as soon as I get this cable here."}, {"t": 928.8, "speaker": null, "line": "Goddamn it, come on."}, {"t": 930.11, "speaker": null, "line": "Why all the way out here?"}, {"t": 933.72, "speaker": null, "line": "We literally could've gotten wiring from any car in town."}, {"t": 937.07, "speaker": null, "line": "My friend, this is a top-of-the-line Audi Q5."}, {"t": 941.03, "speaker": null, "line": "Parts sourced from..."}, {"t": 943.34, "speaker": null, "line": "You really wanna pin our hopes to some peasant model jalopy?"}, {"t": 947.04, "speaker": null, "line": "Yep."}, {"t": 949.47, "speaker": null, "line": "You got all that?"}, {"t": 953.52, "speaker": null, "line": "Whoo! We're doing it!"}, {"t": 955.52, "speaker": null, "line": "Science!"}, {"t": 967.97, "speaker": null, "line": "Good morning."}, {"t": 970.58, "speaker": null, "line": "Uh, I'm dropping these off for storage."}, {"t": 985.34, "speaker": null, "line": "Hey."}, {"t": 987.25, "speaker": null, "line": "Honey, she's not here. She's not gonna hurt you."}, {"t": 990.43, "speaker": null, "line": "Promise?"}, {"t": 992.04, "speaker": null, "line": "Yeah, I promise."}, {"t": 997.83, "speaker": null, "line": "Come on."}, {"t": 1004.83, "speaker": null, "line": "Where should I...?"}, {"t": 1007.71, "speaker": null, "line": "Wow. Look at all this stuff."}, {"t": 1017.93, "speaker": null, "line": "Hey."}, {"t": 1019.5, "speaker": null, "line": "Don't touch anything."}, {"t": 1020.94, "speaker": null, "line": "Why?"}, {"t": 1023.03, "speaker": null, "line": "Because this... this used to belong to other people."}, {"t": 1025.85, "speaker": null, "line": "The people who lived here?"}, {"t": 1027.42, "speaker": null, "line": "Mm-hmm."}, {"t": 1028.47, "speaker": null, "line": "Oh."}, {"t": 1031.56, "speaker": null, "line": "It's like the cavern of the lonely dragon."}, {"t": 1034.78, "speaker": null, "line": "Yeah?"}, {"t": 1036.6, "speaker": null, "line": "When the Cromenockle was lost in the rainbow sky,"}, {"t": 1039.65, "speaker": null, "line": "she found a cavern where the lonely dragon lived,"}, {"t": 1042.92, "speaker": null, "line": "and it was full of stuff that nobody wanted."}, {"t": 1046.57, "speaker": null, "line": "But for the lonely dragon,"}, {"t": 1050.75, "speaker": null, "line": "all the stuff was treasure. And guess what."}, {"t": 1052.79, "speaker": null, "line": "What?"}, {"t": 1054.23, "speaker": null, "line": "In one of the big piles of stuff,"}, {"t": 1056.93, "speaker": null, "line": "there was the map of the rainbow sky."}, {"t": 1060.32, "speaker": null, "line": "So, the lonely dragon gave it to the Cromenockle"}, {"t": 1064.15, "speaker": null, "line": "and then she wasn't lost anymore."}, {"t": 1065.98, "speaker": null, "line": "So maybe we'll find a map in here."}, {"t": 1068.68, "speaker": null, "line": "Yeah, maybe we will."}, {"t": 1080.43, "speaker": null, "line": "Mom?"}, {"t": 1082.08, "speaker": null, "line": "Yeah."}, {"t": 1083.87, "speaker": null, "line": "What's wrong?"}, {"t": 1088.13, "speaker": null, "line": "Nothing."}, {"t": 1094.4, "speaker": null, "line": "Yeah, this is it, this one, right here."}, {"t": 1103.11, "speaker": null, "line": "Oh, this'll never work."}, {"t": 1104.67, "speaker": null, "line": "Of course, it's going to work."}, {"t": 1106.2, "speaker": null, "line": "No, it's not nearly tall enough."}, {"t": 1109.59, "speaker": null, "line": "It won't have the signal strength."}, {"t": 1111.11, "speaker": null, "line": "Yeah, listen, we can deal with that, okay?"}, {"t": 1112.94, "speaker": null, "line": "This is just a test run. Look, you're an engineer, right?"}, {"t": 1115.6, "speaker": null, "line": "Amusement parks?"}, {"t": 1117.03, "speaker": null, "line": "Yeah."}, {"t": 1118.82, "speaker": null, "line": "Okay. So, I guess that means one of us built"}, {"t": 1120.86, "speaker": null, "line": "a multi-million-dollar software company"}, {"t": 1122.82, "speaker": null, "line": "and the other does, what, safety tests on the teacup ride?"}, {"t": 1128.65, "speaker": null, "line": "You know what? Do it yourself."}, {"t": 1132.0, "speaker": null, "line": "Huh? Wait, no, no! Hey, look. I'm sorry, okay? I'm sorry."}, {"t": 1134.66, "speaker": null, "line": "People tell me I'm not great when it comes to"}, {"t": 1136.62, "speaker": null, "line": "talking to people."}, {"t": 1137.79, "speaker": null, "line": "You have no idea what it's like"}, {"t": 1139.05, "speaker": null, "line": "being smarter than everyone you know."}, {"t": 1140.71, "speaker": null, "line": "Listen, okay, look, the truth is..."}, {"t": 1143.19, "speaker": null, "line": "I could really use your help."}, {"t": 1145.1, "speaker": null, "line": "Yeah, you could."}, {"t": 1148.24, "speaker": null, "line": "This antenna, it has to go up high."}, {"t": 1151.89, "speaker": null, "line": "That is the highest tree that I could find, but I... I can't."}, {"t": 1154.68, "speaker": null, "line": "I get vertigo."}, {"t": 1158.25, "speaker": null, "line": "So, you brought me out here to climb a tree?"}, {"t": 1163.12, "speaker": null, "line": "Yeah."}, {"t": 1165.73, "speaker": null, "line": "Listen, you don't like me."}, {"t": 1167.17, "speaker": null, "line": "All right? That's fine."}, {"t": 1171.04, "speaker": null, "line": "But if there's even the slightest chance"}, {"t": 1173.22, "speaker": null, "line": "this could work, don't you want to know for sure?"}, {"t": 1180.01, "speaker": null, "line": "Yeah. Yeah, I do."}, {"t": 1185.93, "speaker": null, "line": "Okay."}, {"t": 1188.58, "speaker": null, "line": "All right."}, {"t": 1196.42, "speaker": null, "line": "All right. Pass me up the cable?"}, {"t": 1218.74, "speaker": null, "line": "Kristi, you here?"}, {"t": 1263.74, "speaker": null, "line": "Sheriff Boyd?"}, {"t": 1265.96, "speaker": null, "line": "Kristi, hey."}, {"t": 1269.23, "speaker": null, "line": "I-I was just, uh..."}, {"t": 1271.01, "speaker": null, "line": "I didn't see you upstairs, so..."}, {"t": 1272.14, "speaker": null, "line": "Everything okay?"}, {"t": 1274.89, "speaker": null, "line": "I know you and Kenny are close, and I was just, uh..."}, {"t": 1277.89, "speaker": null, "line": "How's he doing?"}, {"t": 1280.24, "speaker": null, "line": "Well, I mean..."}, {"t": 1283.2, "speaker": null, "line": "I think he's... been having a hard time since..."}, {"t": 1286.94, "speaker": null, "line": "Right, right."}, {"t": 1288.99, "speaker": null, "line": "And I-I think he's trying really hard"}, {"t": 1291.03, "speaker": null, "line": "to be this person that he thinks people need him to be,"}, {"t": 1292.95, "speaker": null, "line": "if that makes sense?"}, {"t": 1294.86, "speaker": null, "line": "Yeah."}, {"t": 1296.43, "speaker": null, "line": "Being your deputy and..."}, {"t": 1299.17, "speaker": null, "line": "and I know a big thing for him"}, {"t": 1301.87, "speaker": null, "line": "is he doesn't want to let you down."}, {"t": 1303.92, "speaker": null, "line": "I know. And I'm really trying not to push him too hard."}, {"t": 1307.44, "speaker": null, "line": "The truth is, he needs to be ready to lead."}, {"t": 1309.31, "speaker": null, "line": "Can I be honest with you?"}, {"t": 1310.84, "speaker": null, "line": "Please."}, {"t": 1313.1, "speaker": null, "line": "I get that you want to prepare him for the worst,"}, {"t": 1315.32, "speaker": null, "line": "get him ready to take your place in case something ever..."}, {"t": 1320.32, "speaker": null, "line": "But right now, he's really hurting,"}, {"t": 1322.89, "speaker": null, "line": "and I don't think he needs a sheriff."}, {"t": 1324.94, "speaker": null, "line": "I think he needs a dad."}, {"t": 1329.24, "speaker": null, "line": "Goddamn it."}, {"t": 1331.81, "speaker": null, "line": "I'm sorry, I..."}, {"t": 1333.25, "speaker": null, "line": "No, no, no."}, {"t": 1334.55, "speaker": null, "line": "It's... It's not you. It's me."}, {"t": 1336.95, "speaker": null, "line": "It's..."}, {"t": 1339.25, "speaker": null, "line": "If you don't learn from your mistakes,"}, {"t": 1341.08, "speaker": null, "line": "you're doomed to repeat them, right?"}, {"t": 1342.56, "speaker": null, "line": "I really didn't mean to..."}, {"t": 1346.13, "speaker": null, "line": "You didn't."}, {"t": 1346.13, "speaker": null, "line": "No apology."}, {"t": 1351.18, "speaker": null, "line": "Thank you, Kristi."}, {"t": 1375.42, "speaker": null, "line": "People think the Bible's a fixed object -"}, {"t": 1379.51, "speaker": null, "line": "something written, completed."}, {"t": 1383.6, "speaker": null, "line": "But how can the story be finished"}, {"t": 1385.3, "speaker": null, "line": "if all the players remain on stage?"}, {"t": 1389.22, "speaker": null, "line": "We call it \"the Good Book\", but..."}, {"t": 1393.7, "speaker": null, "line": "Did you know it's actually comprised of 73 books?"}, {"t": 1397.88, "speaker": null, "line": "Did you know that?"}, {"t": 1401.53, "speaker": null, "line": "Matthew, Mark,"}, {"t": 1405.06, "speaker": null, "line": "Romans, Corinthians."}, {"t": 1407.24, "speaker": null, "line": "Seventy-three books."}, {"t": 1410.33, "speaker": null, "line": "All filled with tales of miracle and wonder."}, {"t": 1419.33, "speaker": null, "line": "But there's also darkness in the Bible."}, {"t": 1422.95, "speaker": null, "line": "Gruesome, horrible things."}, {"t": 1425.95, "speaker": null, "line": "You know, since..."}, {"t": 1427.87, "speaker": null, "line": "Since the night I arrived,"}, {"t": 1432.04, "speaker": null, "line": "there seems to be a question I keep coming back to."}, {"t": 1441.05, "speaker": null, "line": "Seventy-three books."}, {"t": 1445.01, "speaker": null, "line": "What if we,"}, {"t": 1447.93, "speaker": null, "line": "the people of this town,"}, {"t": 1451.76, "speaker": null, "line": "are living the book that has yet to be written?"}, {"t": 1455.98, "speaker": null, "line": "What if this is Book 74?"}, {"t": 1462.16, "speaker": null, "line": "And, Sara, what if we were chosen?"}, {"t": 1468.12, "speaker": null, "line": "For what?"}, {"t": 1473.13, "speaker": null, "line": "I don't know."}, {"t": 1479.13, "speaker": null, "line": "Which is why I need you to tell me about these voices."}, {"t": 1487.4, "speaker": null, "line": "Please."}, {"t": 1496.06, "speaker": null, "line": "When's Dad coming home?"}, {"t": 1500.15, "speaker": null, "line": "Soon, honey."}, {"t": 1501.77, "speaker": null, "line": "I don't think he will be much longer."}, {"t": 1506.47, "speaker": null, "line": "What's wrong?"}, {"t": 1510.12, "speaker": null, "line": "Nothing. I'm just..."}, {"t": 1513.17, "speaker": null, "line": "Just admiring this piece of lonely dragon's treasure."}, {"t": 1515.95, "speaker": null, "line": "It's pretty."}, {"t": 1519.22, "speaker": null, "line": "Yeah."}, {"t": 1523.44, "speaker": null, "line": "Why does that light keep turning off?"}, {"t": 1530.14, "speaker": null, "line": "I don't know."}, {"t": 1532.97, "speaker": null, "line": "How about you and I have an adventure?"}, {"t": 1536.06, "speaker": null, "line": "What kind of adventure?"}, {"t": 1538.02, "speaker": null, "line": "Mm, some sort of, um, treasure hunt."}, {"t": 1541.28, "speaker": null, "line": "Really?"}, {"t": 1542.98, "speaker": null, "line": "Mm-hmm."}, {"t": 1544.29, "speaker": null, "line": "Yeah, the game's gonna be called,"}, {"t": 1546.2, "speaker": null, "line": "\"Where does the light come from?\""}, {"t": 1548.99, "speaker": null, "line": "Sounds good?"}, {"t": 1550.73, "speaker": null, "line": "Yeah."}, {"t": 1550.73, "speaker": null, "line": "Let's do it."}, {"t": 1553.16, "speaker": null, "line": "Let's go. Okay, we will need some tools, right?"}, {"t": 1556.99, "speaker": null, "line": "Mm-hmm."}, {"t": 1558.0, "speaker": null, "line": "Ooh, I found your tool!"}, {"t": 1562.0, "speaker": null, "line": "Let's see if I've..."}, {"t": 1565.22, "speaker": null, "line": "found my tool."}, {"t": 1568.01, "speaker": null, "line": "Okay."}, {"t": 1573.05, "speaker": null, "line": "Let's move this."}, {"t": 1574.53, "speaker": null, "line": "Come on, honey. I need you to push. Help me."}, {"t": 1583.02, "speaker": null, "line": "Okeydokey."}, {"t": 1585.2, "speaker": null, "line": "Now, this is your tool."}, {"t": 1587.07, "speaker": null, "line": "This is my tool. Ready?"}, {"t": 1591.16, "speaker": null, "line": "Mom!"}, {"t": 1594.38, "speaker": null, "line": "You're doin' great!"}, {"t": 1603.34, "speaker": null, "line": "Here we go."}, {"t": 1612.31, "speaker": null, "line": "Hey, I'm snagged somewhere. Can you see where it's caught?"}, {"t": 1614.27, "speaker": null, "line": "Uh, no, not really."}, {"t": 1616.97, "speaker": null, "line": "Just, uh, give it a shake, see if you can wiggle it free."}, {"t": 1622.41, "speaker": null, "line": "Yeah, that's it."}, {"t": 1624.15, "speaker": null, "line": "You got it?"}, {"t": 1624.15, "speaker": null, "line": "Yup."}, {"t": 1632.37, "speaker": null, "line": "All right."}, {"t": 1634.38, "speaker": null, "line": "Okay. How you doing up there?"}, {"t": 1637.03, "speaker": null, "line": "Doing good."}, {"t": 1639.99, "speaker": null, "line": "Fuck!"}, {"t": 1643.21, "speaker": null, "line": "Oh, Jesus."}, {"t": 1671.46, "speaker": null, "line": "No, no, no! No!"}, {"t": 1693.48, "speaker": null, "line": "No, no, no! No, no!"}, {"t": 1699.53, "speaker": null, "line": "No, no!"}, {"t": 1703.1, "speaker": null, "line": "Hey. Hey."}, {"t": 1707.27, "speaker": null, "line": "Jade, wh..."}, {"t": 1709.28, "speaker": null, "line": "Jade, Jade, right here. Right here."}, {"t": 1712.28, "speaker": null, "line": "Listen, whatever it is, it's not real. Okay?"}, {"t": 1714.67, "speaker": null, "line": "There's nothing there."}, {"t": 1717.46, "speaker": null, "line": "Jade, I'm going to help you up."}, {"t": 1719.33, "speaker": null, "line": "Come here. Come here."}, {"t": 1721.11, "speaker": null, "line": "You okay? Huh?"}, {"t": 1723.29, "speaker": null, "line": "Just get your fucking hands off me!"}, {"t": 1724.64, "speaker": null, "line": "What did you see?"}, {"t": 1726.25, "speaker": null, "line": "Just fuck off, all right?"}, {"t": 1733.43, "speaker": null, "line": "They said they wanted to help."}, {"t": 1736.39, "speaker": null, "line": "That they'd been here a long time"}, {"t": 1738.7, "speaker": null, "line": "and they'd been waiting"}, {"t": 1740.35, "speaker": null, "line": "for someone to come who would hear them,"}, {"t": 1743.27, "speaker": null, "line": "someone who could help them."}, {"t": 1745.23, "speaker": null, "line": "Help them do what?"}, {"t": 1746.53, "speaker": null, "line": "Help them escape."}, {"t": 1748.66, "speaker": null, "line": "Help them go home."}, {"t": 1750.84, "speaker": null, "line": "They said they were just like us."}, {"t": 1753.67, "speaker": null, "line": "But why? Why did you believe them?"}, {"t": 1758.33, "speaker": null, "line": "Because... they told me things,"}, {"t": 1762.37, "speaker": null, "line": "things they couldn't know."}, {"t": 1765.81, "speaker": null, "line": "They told me those two cars were coming"}, {"t": 1769.42, "speaker": null, "line": "and to stand out near the edge of town and I would see."}, {"t": 1773.78, "speaker": null, "line": "They said it happened before,"}, {"t": 1776.26, "speaker": null, "line": "that two cars came on the same day"}, {"t": 1780.48, "speaker": null, "line": "and everyone died."}, {"t": 1783.66, "speaker": null, "line": "They said it was because of the people in the cars, but if..."}, {"t": 1789.31, "speaker": null, "line": "...if I did what they said,"}, {"t": 1792.71, "speaker": null, "line": "that we'd be safe, we'd get to go home."}, {"t": 1798.28, "speaker": null, "line": "Okay. How?"}, {"t": 1800.67, "speaker": null, "line": "How would we get to go home?"}, {"t": 1809.68, "speaker": null, "line": "I don't know."}, {"t": 1809.68, "speaker": null, "line": "Okay."}, {"t": 1812.03, "speaker": null, "line": "Do you still believe that they were telling the truth?"}, {"t": 1815.95, "speaker": null, "line": "They promised... that Nathan would be okay."}, {"t": 1822.39, "speaker": null, "line": "They-they promised, and now, now he's..."}, {"t": 1828.48, "speaker": null, "line": "Sara."}, {"t": 1829.88, "speaker": null, "line": "Sara, listen to me. Come here."}, {"t": 1831.36, "speaker": null, "line": "Listen to me. Listen to me, Sara."}, {"t": 1833.53, "speaker": null, "line": "If these voices are real,"}, {"t": 1835.75, "speaker": null, "line": "if something here is communicating with you,"}, {"t": 1837.84, "speaker": null, "line": "then that means you're connected to this place"}, {"t": 1839.75, "speaker": null, "line": "in a way that no one else here is,"}, {"t": 1841.41, "speaker": null, "line": "and that makes you incredibly valuable."}, {"t": 1843.67, "speaker": null, "line": "Do you understand?"}, {"t": 1844.85, "speaker": null, "line": "But we need proof."}, {"t": 1846.94, "speaker": null, "line": "We need to be able to go to Sheriff Boyd"}, {"t": 1850.59, "speaker": null, "line": "and tell him with absolute certainty that you..."}, {"t": 1853.46, "speaker": null, "line": "That I'm not crazy."}, {"t": 1854.81, "speaker": null, "line": "No, the voices, that these voices are not simply"}, {"t": 1857.51, "speaker": null, "line": "the product of a troubled mind."}, {"t": 1859.43, "speaker": null, "line": "So, Sara, I need..."}, {"t": 1861.56, "speaker": null, "line": "Ow!"}, {"t": 1862.65, "speaker": null, "line": "Sara?"}, {"t": 1862.65, "speaker": null, "line": "Ow."}, {"t": 1863.82, "speaker": null, "line": "What?"}, {"t": 1863.82, "speaker": null, "line": "Ow. No!"}, {"t": 1865.78, "speaker": null, "line": "What?"}, {"t": 1868.0, "speaker": null, "line": "Sara."}, {"t": 1868.0, "speaker": null, "line": "No! No!"}, {"t": 1870.0, "speaker": null, "line": "What?"}, {"t": 1870.0, "speaker": null, "line": "No, no, no!"}, {"t": 1872.0, "speaker": null, "line": "What?"}, {"t": 1872.0, "speaker": null, "line": "Please! Ah, no, no!"}, {"t": 1874.7, "speaker": null, "line": "What?"}, {"t": 1876.79, "speaker": null, "line": "Sara, what is it?"}, {"t": 1876.79, "speaker": null, "line": "Ah, no!"}, {"t": 1878.36, "speaker": null, "line": "What?"}, {"t": 1879.45, "speaker": null, "line": "I need... I need..."}, {"t": 1881.62, "speaker": null, "line": "Need what?"}, {"t": 1882.62, "speaker": null, "line": "Paper."}, {"t": 1883.89, "speaker": null, "line": "Paper."}, {"t": 1890.02, "speaker": null, "line": "They want me to show you something."}, {"t": 1930.45, "speaker": null, "line": "Hello? Is anybody out there?"}, {"t": 1937.55, "speaker": null, "line": "Hello?"}, {"t": 1942.03, "speaker": null, "line": "Is anybody there?"}, {"t": 1962.75, "speaker": null, "line": "I don't want any tea!"}, {"t": 1971.58, "speaker": null, "line": "You realize I have no idea what you're saying."}, {"t": 1976.46, "speaker": null, "line": "Fine."}, {"t": 1986.03, "speaker": null, "line": "It's good."}, {"t": 1987.64, "speaker": null, "line": "Thanks."}, {"t": 1996.04, "speaker": null, "line": "I keep seeing it. I-I keep..."}, {"t": 2000.44, "speaker": null, "line": "I keep having these, uh..."}, {"t": 2007.14, "speaker": null, "line": "Hey, where are you going?"}, {"t": 2013.1, "speaker": null, "line": "Hello?"}, {"t": 2015.8, "speaker": null, "line": "Where'd you go?"}, {"t": 2027.07, "speaker": null, "line": "Holy shit."}, {"t": 2029.99, "speaker": null, "line": "This is all the, uh..."}, {"t": 2032.56, "speaker": null, "line": "Wow. Oh, wait, wait! Hold on."}, {"t": 2034.95, "speaker": null, "line": "Slow down, Tian. I got this."}, {"t": 2042.65, "speaker": null, "line": "What..."}, {"t": 2044.57, "speaker": null, "line": "What are you looking for?"}, {"t": 2050.57, "speaker": null, "line": "What is that? It's a yearbook."}, {"t": 2052.75, "speaker": null, "line": "1972? How many people...?"}, {"t": 2058.93, "speaker": null, "line": "Okay."}, {"t": 2061.19, "speaker": null, "line": "Well, I mean, could you tell me what you're looking for?"}, {"t": 2063.98, "speaker": null, "line": "Shh."}, {"t": 2068.98, "speaker": null, "line": "What's that?"}, {"t": 2074.82, "speaker": null, "line": "Hmm?"}, {"t": 2093.36, "speaker": null, "line": "Oh, what the fuck?"}, {"t": 2110.98, "speaker": null, "line": "Please..."}, {"t": 2112.07, "speaker": null, "line": "I can't..."}, {"t": 2134.05, "speaker": null, "line": "I don't..."}, {"t": 2137.53, "speaker": null, "line": "What is this?"}, {"t": 2139.88, "speaker": null, "line": "They said..."}, {"t": 2142.41, "speaker": null, "line": "They said they watched you on the day you got here."}, {"t": 2147.06, "speaker": null, "line": "They said they watched you bury the bag"}, {"t": 2150.76, "speaker": null, "line": "and that this is proof that they're real."}, {"t": 2158.2, "speaker": null, "line": "Do you know what that means?"}, {"t": 2178.05, "speaker": null, "line": "Oh!"}, {"t": 2184.23, "speaker": null, "line": "Ah! Here we go."}, {"t": 2186.93, "speaker": null, "line": "Okay."}, {"t": 2189.8, "speaker": null, "line": "Yeah."}, {"t": 2191.32, "speaker": null, "line": "That's it. There we go."}, {"t": 2197.55, "speaker": null, "line": "Hey."}, {"t": 2198.64, "speaker": null, "line": "Sheriff Boyd."}, {"t": 2203.12, "speaker": null, "line": "Ladies."}, {"t": 2204.25, "speaker": null, "line": "Hi!"}, {"t": 2210.65, "speaker": null, "line": "Fuck!"}, {"t": 2215.13, "speaker": null, "line": "Come in."}, {"t": 2217.78, "speaker": null, "line": "Hey."}, {"t": 2225.4, "speaker": null, "line": "I was, uh, going through my things back at the station,"}, {"t": 2229.54, "speaker": null, "line": "and I realized I haven't thrown a ball around in a while."}, {"t": 2232.97, "speaker": null, "line": "Come on outside."}, {"t": 2234.8, "speaker": null, "line": "You can help an old man knock the rust off."}, {"t": 2236.72, "speaker": null, "line": "I'm good."}, {"t": 2242.11, "speaker": null, "line": "Hey, I ever tell you, uh,"}, {"t": 2244.72, "speaker": null, "line": "I played first base back in college."}, {"t": 2246.99, "speaker": null, "line": "No."}, {"t": 2248.82, "speaker": null, "line": "Yeah, I was pretty good too."}, {"t": 2250.47, "speaker": null, "line": "Had a couple scouts kicking around."}, {"t": 2253.3, "speaker": null, "line": "Here I am, 18 years old, thinkin',"}, {"t": 2256.13, "speaker": null, "line": "\"Man, I might be going to the show,\""}, {"t": 2259.13, "speaker": null, "line": "\"be the next Willie McCovey.\""}, {"t": 2262.35, "speaker": null, "line": "What happened?"}, {"t": 2266.75, "speaker": null, "line": "Oh, you know..."}, {"t": 2270.75, "speaker": null, "line": "life had other plans."}, {"t": 2276.19, "speaker": null, "line": "Life always seems to have other plans."}, {"t": 2287.16, "speaker": null, "line": "I'm sick, Kenny."}, {"t": 2292.86, "speaker": null, "line": "What do you...?"}, {"t": 2294.43, "speaker": null, "line": "Have you talked to Kristi about it?"}, {"t": 2296.78, "speaker": null, "line": "Not that kind of sick."}, {"t": 2299.91, "speaker": null, "line": "My father was diagnosed with Parkinson's"}, {"t": 2302.22, "speaker": null, "line": "when he was around my age."}, {"t": 2303.96, "speaker": null, "line": "It's not supposed to be hereditary."}, {"t": 2306.44, "speaker": null, "line": "The doctors all swore up and down"}, {"t": 2307.83, "speaker": null, "line": "how extremely rare that would be."}, {"t": 2310.88, "speaker": null, "line": "Wrong time to win the lottery, I guess."}, {"t": 2313.92, "speaker": null, "line": "But how do you know that...? How do you know?"}, {"t": 2318.36, "speaker": null, "line": "I mean, it could be anything, right?"}, {"t": 2319.8, "speaker": null, "line": "It is what it is."}, {"t": 2323.32, "speaker": null, "line": "Look..."}, {"t": 2326.55, "speaker": null, "line": "this thing is already chipping away at me."}, {"t": 2330.72, "speaker": null, "line": "And eventually, I'm gonna get to the point where I can't..."}, {"t": 2333.99, "speaker": null, "line": "I'm not gonna be able to protect these people anymore."}, {"t": 2339.08, "speaker": null, "line": "So I gotta find us a way out while I still can."}, {"t": 2343.3, "speaker": null, "line": "You understand?"}, {"t": 2345.87, "speaker": null, "line": "The only way I can do this"}, {"t": 2348.65, "speaker": null, "line": "is because I know these people are gonna be in good hands"}, {"t": 2350.74, "speaker": null, "line": "when I'm gone."}, {"t": 2354.88, "speaker": null, "line": "There's a lot of folks in this town"}, {"t": 2356.88, "speaker": null, "line": "who are alive today because of you."}, {"t": 2361.1, "speaker": null, "line": "And I know your dad isn't around to say it,"}, {"t": 2364.19, "speaker": null, "line": "but I promise you..."}, {"t": 2366.93, "speaker": null, "line": "he's so goddamn proud of you."}, {"t": 2370.42, "speaker": null, "line": "I'm proud of you."}, {"t": 2372.37, "speaker": null, "line": "But if you tell me right now"}, {"t": 2375.9, "speaker": null, "line": "that you are not ready for me to go,"}, {"t": 2378.34, "speaker": null, "line": "that you need more time,"}, {"t": 2382.51, "speaker": null, "line": "then I ain't going nowhere."}, {"t": 2384.82, "speaker": null, "line": "Okay?"}, {"t": 2403.06, "speaker": null, "line": "Well, we doing this or what?"}, {"t": 2406.89, "speaker": null, "line": "Doing it."}, {"t": 2412.04, "speaker": null, "line": "Hey? Anybody here?"}, {"t": 2416.39, "speaker": null, "line": "We might be onto something with this radio."}, {"t": 2419.87, "speaker": null, "line": "We're gonna have to get it higher up, but it could..."}, {"t": 2425.58, "speaker": null, "line": "What the fuck?"}, {"t": 2429.71, "speaker": null, "line": "Hi, Dad."}, {"t": 2431.67, "speaker": null, "line": "Hey, kiddo."}, {"t": 2432.97, "speaker": null, "line": "What you up to?"}, {"t": 2434.24, "speaker": null, "line": "We're on an adventure."}, {"t": 2435.59, "speaker": null, "line": "There's a lot of dirt,"}, {"t": 2437.24, "speaker": null, "line": "so mom said I should bring some outside."}, {"t": 2439.63, "speaker": null, "line": "Uh-huh. And where is your mother?"}, {"t": 2441.11, "speaker": null, "line": "In the basement."}, {"t": 2465.62, "speaker": null, "line": "Tabitha?"}, {"t": 2467.14, "speaker": null, "line": "Hey. Hey. How'd things go?"}, {"t": 2470.58, "speaker": null, "line": "Good."}, {"t": 2471.84, "speaker": null, "line": "Yeah?"}, {"t": 2473.14, "speaker": null, "line": "We got some static, so..."}, {"t": 2474.89, "speaker": null, "line": "Yeah, well, that's wonderful, right?"}, {"t": 2476.76, "speaker": null, "line": "Yeah, it's a start."}, {"t": 2478.59, "speaker": null, "line": "What you doing?"}, {"t": 2480.37, "speaker": null, "line": "It's like you said this morning,"}, {"t": 2482.28, "speaker": null, "line": "it has to come from somewhere, right? The electricity."}, {"t": 2485.77, "speaker": null, "line": "There's no power lines, and all the wires,"}, {"t": 2489.2, "speaker": null, "line": "all the cords, they just..."}, {"t": 2490.95, "speaker": null, "line": "they just go down, straight down."}, {"t": 2493.9, "speaker": null, "line": "It's so weird."}, {"t": 2497.65, "speaker": null, "line": "Okay. Uh, sorry, can you..."}, {"t": 2500.65, "speaker": null, "line": "not dig for a moment?"}, {"t": 2502.57, "speaker": null, "line": "Yes."}, {"t": 2506.22, "speaker": null, "line": "What's going on?"}, {"t": 2507.74, "speaker": null, "line": "Okay."}, {"t": 2512.75, "speaker": null, "line": "Do you remember the bracelet I made you?"}, {"t": 2516.54, "speaker": null, "line": "The what?"}, {"t": 2518.49, "speaker": null, "line": "The bracelet I made you after our first few dates,"}, {"t": 2520.89, "speaker": null, "line": "from, uh, the laces of your father's boots."}, {"t": 2522.76, "speaker": null, "line": "Yeah, of course, I remember."}, {"t": 2524.33, "speaker": null, "line": "Okay. Remember,"}, {"t": 2525.72, "speaker": null, "line": "you lost it at the hospital the night Julie was born."}, {"t": 2528.64, "speaker": null, "line": "Okay."}, {"t": 2530.72, "speaker": null, "line": "Turn around. Look what's sitting there."}, {"t": 2547.04, "speaker": null, "line": "Okay, I still don't get it."}, {"t": 2548.92, "speaker": null, "line": "You're saying you found a bracelet"}, {"t": 2550.74, "speaker": null, "line": "that's similar to the one you gave..."}, {"t": 2552.09, "speaker": null, "line": "No, no, no, no. It's not similar."}, {"t": 2553.92, "speaker": null, "line": "That is the bracelet. Those are the laces"}, {"t": 2555.71, "speaker": null, "line": "from your father's boots!"}, {"t": 2556.75, "speaker": null, "line": "No, those were generic rawhide laces,"}, {"t": 2558.75, "speaker": null, "line": "the same you'd find on any boot."}, {"t": 2560.93, "speaker": null, "line": "No, no, no, no, no, no. Look. Look at this."}, {"t": 2563.89, "speaker": null, "line": "Look at this."}, {"t": 2564.89, "speaker": null, "line": "What?"}, {"t": 2566.5, "speaker": null, "line": "This was an accident. I made this."}, {"t": 2569.24, "speaker": null, "line": "I was so afraid I ruined it, but then, when I gave it to you,"}, {"t": 2571.94, "speaker": null, "line": "you said, \"Accidents... \""}, {"t": 2573.07, "speaker": null, "line": "\"Accidents are the best part.\""}, {"t": 2574.64, "speaker": null, "line": "Yes. Why?"}, {"t": 2576.51, "speaker": null, "line": "Ah, because it makes it one of a kind."}, {"t": 2577.99, "speaker": null, "line": "Exactly."}, {"t": 2584.73, "speaker": null, "line": "It's impossible."}, {"t": 2587.0, "speaker": null, "line": "Jim, everything about this is impossible."}, {"t": 2589.26, "speaker": null, "line": "That doesn't make any sense."}, {"t": 2590.78, "speaker": null, "line": "Those wires don't make sense."}, {"t": 2593.57, "speaker": null, "line": "We may not be able to find out how this got here,"}, {"t": 2596.05, "speaker": null, "line": "but we can find out where those wires go."}, {"t": 2602.06, "speaker": null, "line": "Give me the shovel."}, {"t": 2682.48, "speaker": null, "line": "Where's yours?"}, {"t": 2684.14, "speaker": null, "line": "First base. I don't need no glove."}, {"t": 2687.4, "speaker": null, "line": "Are you sure? Because I got some heat."}, {"t": 2689.23, "speaker": null, "line": "Just throw the damn ball."}, {"t": 2691.19, "speaker": null, "line": "You're gonna regret this."}, {"t": 2693.28, "speaker": null, "line": "I hear a lot of talking, but I'm not..."}, {"t": 2695.8, "speaker": null, "line": "Here comes the heat."}, {"t": 2701.07, "speaker": null, "line": "I think, uh... Think maybe I'll carve us a bat."}, {"t": 2706.03, "speaker": null, "line": "That way, when you get back, we can do this right."}, {"t": 2710.08, "speaker": null, "line": "When I get back, huh?"}, {"t": 2713.52, "speaker": null, "line": "Yeah, when you get back."}, {"t": 2727.14, "speaker": null, "line": "Yeah."}, {"t": 2809.96, "speaker": null, "line": "They're so beautiful."}, {"t": 2814.05, "speaker": null, "line": "I'm so glad you like them."}, {"t": 2816.66, "speaker": null, "line": "When can I come inside?"}]}